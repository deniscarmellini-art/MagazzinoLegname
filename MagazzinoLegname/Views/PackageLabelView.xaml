<UserControl x:Class="MagazzinoLegname.Views.PackageLabelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1122.52" Height="793.7" Background="White"
             FontFamily="Arial" TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="LabelCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="LabelValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DataCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="#B5B5B5"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,13,12,10"/>
        </Style>
    </UserControl.Resources>

    <Border Margin="12" BorderBrush="Black" BorderThickness="1.4" Background="White">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

            <!-- FRONTE PACCO -->
            <Grid Grid.Column="0" Margin="42,28,42,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.25*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="2.65*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="2.15*"/>
                    <RowDefinition Height="0.9*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,5">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both" Margin="10,0">
                        <TextBlock Text="{Binding Package.IncomingThickness, StringFormat={}{0:0.##}}"
                                   Foreground="#000000" FontFamily="Arial" FontSize="100" FontWeight="Bold"/>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="SPESSORE" Foreground="Black" FontSize="20"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>
                <Border Grid.Row="1" Background="#9B9B9B"/>

                <Grid Grid.Row="2" Margin="20,5">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both" Margin="10,0">
                        <TextBlock Text="{Binding Package.WidthAfterPlaning, StringFormat={}{0:0.##}}"
                                   Foreground="#000000" FontFamily="Arial" FontSize="100" FontWeight="Bold"/>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="LARGHEZZA" Foreground="Black"
                               FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>
                <Border Grid.Row="3" Background="#9B9B9B"/>

                <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Package.Quality}" Foreground="#000000"
                               FontFamily="Arial" FontSize="72" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="QUALITÀ" Foreground="Black" FontSize="20"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <Image Grid.Row="5" Source="{Binding QrImage}" Width="70" Height="70"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Grid>

            <!-- LATO PACCO -->
            <Grid Grid.Column="1" Margin="105,45,12,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="MISURE" Style="{StaticResource LabelCaption}"/>
                    <TextBlock Text="{Binding OperationalMeasure}" Foreground="Black"
                               FontSize="43" FontWeight="Black" TextWrapping="NoWrap" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="#8F8F8F" BorderThickness="0,1,0,0" Padding="0,18,0,14">
                    <StackPanel>
                        <TextBlock Text="FORNITORE" Style="{StaticResource LabelCaption}"/>
                        <TextBlock Text="{Binding SupplierName}" Foreground="Black" FontSize="27"
                                   FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

                    <Border Style="{StaticResource DataCell}" BorderThickness="0,1,1,0">
                        <StackPanel><TextBlock Text="NUMERO CARICO" Style="{StaticResource LabelCaption}"/><TextBlock Text="{Binding LoadNumber}" Style="{StaticResource LabelValue}" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DataCell}" Padding="26,13,0,10">
                        <StackPanel><TextBlock Text="NUMERO DDT" Style="{StaticResource LabelCaption}"/><TextBlock Text="{Binding DisplayDeliveryNoteNumber}" Style="{StaticResource LabelValue}" Margin="0,6,0,0"/></StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource DataCell}" BorderThickness="0,1,1,0">
                        <StackPanel><TextBlock Text="PACCO" Style="{StaticResource LabelCaption}"/><TextBlock Text="{Binding PackagePosition}" Style="{StaticResource LabelValue}" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DataCell}" Padding="26,13,0,10">
                        <StackPanel><TextBlock Text="DATA ARRIVO" Style="{StaticResource LabelCaption}"/><TextBlock Text="{Binding Package.ArrivalDate, StringFormat=dd/MM/yyyy}" Style="{StaticResource LabelValue}" Margin="0,6,0,0"/></StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource DataCell}" BorderThickness="0,1,1,0">
                        <StackPanel><TextBlock Text="PEZZI" Style="{StaticResource LabelCaption}"/><TextBlock Text="{Binding Package.PieceCount}" Style="{StaticResource LabelValue}" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DataCell}" Padding="26,13,0,10">
                        <StackPanel><TextBlock Text="QUALITÀ" Style="{StaticResource LabelCaption}"/><TextBlock Text="{Binding Package.Quality}" Style="{StaticResource LabelValue}" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" BorderBrush="#B5B5B5" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="CERTIFICAZIONE" Style="{StaticResource LabelCaption}"/>
                        <TextBlock Text="{Binding Certification}" Foreground="Black" FontSize="29" FontWeight="Black" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <Image Source="{Binding QrImage}" Width="112" Height="112" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock Text="CODICE PACCO" Foreground="Black" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Package.PackageCode}" Foreground="Black" FontSize="25"
                               FontWeight="Black" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- riferimento leggero per la piega -->
            <Border Grid.ColumnSpan="2" Width="1" HorizontalAlignment="Center" Margin="0,0,0,0"
                    BorderBrush="#8E8E8E" BorderThickness="1,0,0,0" Opacity="0.75">
                <Border.OpacityMask>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,1,12" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="Black" Geometry="M 0,0 L 1,0 1,6 0,6 Z"/>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.OpacityMask>
            </Border>
        </Grid>
    </Border>
</UserControl>
