<UserControl x:Class="MagazzinoLegname.Views.PlanningView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="2,0,0,16"><TextBlock Text="Pianificazione" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Organizzazione delle attività e dei fabbisogni futuri." Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Valori settimanali per spessore" FontSize="20" FontWeight="Bold"/><TextBlock Text="Prima predisposizione dei volumi attesi e dei consumi; la progettazione dettagliata verrà completata successivamente." Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,18"/><ItemsControl ItemsSource="{Binding WeeklyValues}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="18" Margin="7,0"><StackPanel><TextBlock Text="{Binding ConventionalThickness, StringFormat=SPESSORE {0:N0}}" Foreground="{DynamicResource AccentBrush}" FontWeight="ExtraBold" FontSize="20" Margin="0,0,0,15"/><TextBlock Text="M³ TEORICI PER ARRIVO PREVISTO" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding TheoreticalCubicMetersPerExpectedArrival, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,13"/><TextBlock Text="CONSUMO SETTIMANALE PREVISTO (M³)" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding ExpectedWeeklyConsumption, UpdateSourceTrigger=LostFocus}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
 </Grid></ScrollViewer>
</UserControl>
