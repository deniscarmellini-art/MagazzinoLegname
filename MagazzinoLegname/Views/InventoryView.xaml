<UserControl x:Class="MagazzinoLegname.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="InventoryCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" Width="520"><TextBlock Text="Disponibilità Magazzino" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Tutti i pacchi fisicamente presenti, indipendentemente dallo stato di classificazione." Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="9" Padding="14,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="PACCHI PRESENTI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding PresentPackages, Mode=OneWay}" FontSize="20" FontWeight="ExtraBold"/></StackPanel></Border>
                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="9" Padding="14,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="MC TOTALI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding TotalInventoryCubicMeters, Mode=OneWay, StringFormat=N3}" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="9" Padding="14,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="MC TEORICI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding TheoreticalCubicMeters, Mode=OneWay, StringFormat=N3}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="9" Padding="14,8"><StackPanel><TextBlock Text="MC RETTIFICATI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding RealCubicMeters, Mode=OneWay, StringFormat=N3}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="13" Margin="0,0,0,9">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,9,0"><TextBlock Text="FORNITORE" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Suppliers, Mode=OneWay}" SelectedItem="{Binding SelectedSupplier}"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,9,0"><TextBlock Text="SPESSORE" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Thicknesses, Mode=OneWay}" SelectedItem="{Binding SelectedThickness}"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,9,0"><TextBlock Text="LARGHEZZA" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Widths, Mode=OneWay}" SelectedItem="{Binding SelectedWidth}"/></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,9,0"><TextBlock Text="QUALITÀ" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Qualities, Mode=OneWay}" SelectedItem="{Binding SelectedQuality}"/></StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,9,0"><TextBlock Text="STATO CLASSIFICAZIONE" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding ClassificationStatuses, Mode=OneWay}" SelectedItem="{Binding SelectedClassificationStatus}"/></StackPanel>
                <StackPanel Grid.Column="5"><TextBlock Text="RETTIFICA SCARTI" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding WasteStatuses, Mode=OneWay}" SelectedItem="{Binding SelectedWasteStatus}"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding VisiblePackages, Mode=OneWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionUnit="FullRow" RowHeight="43" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Codice pacco" Width="130" Binding="{Binding PackageCode, Mode=OneWay}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="Carico" Width="65" Binding="{Binding LoadNumber, Mode=OneWay}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="Fornitore" Width="155" Binding="{Binding SupplierName, Mode=OneWay}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="Data arrivo" Width="90" Binding="{Binding ArrivalDate, Mode=OneWay, StringFormat=dd/MM/yyyy}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="Pacco" Width="65" Binding="{Binding PackagePosition, Mode=OneWay}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="Spessore" Width="75" Binding="{Binding ConventionalThickness, Mode=OneWay, StringFormat=N0}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="Larghezza" Width="80" Binding="{Binding WidthAfterPlaning, Mode=OneWay, StringFormat=N0}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="Lunghezza" Width="85" Binding="{Binding IncomingLength, Mode=OneWay, StringFormat=N0}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="Qualità" Width="65" Binding="{Binding Quality, Mode=OneWay}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTemplateColumn Header="Stato" Width="190">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#172839" CornerRadius="7" Padding="9,5" Margin="5" HorizontalAlignment="Stretch"><TextBlock Text="{Binding InventoryStatus, Mode=OneWay}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Stretch"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Rettifica scarti" Width="105">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding WasteAdjustmentStatus, Mode=OneWay}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.ToolTip><StackPanel><TextBlock Text="Dati della rettifica del gruppo" FontWeight="Bold"/><TextBlock Text="{Binding WasteAdjustmentDate, Mode=OneWay, StringFormat=Data: {0:dd/MM/yyyy HH:mm}, TargetNullValue=Non ancora effettuata}"/><TextBlock Text="{Binding WasteAdjustmentOperator, Mode=OneWay, StringFormat=Operatore: {0}, TargetNullValue=—}"/></StackPanel></TextBlock.ToolTip></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="MC ingresso" Width="95" Binding="{Binding IncomingCubicMeters, Mode=OneWay, StringFormat=N6}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="Sfrido lavorazioni %" Width="130" Binding="{Binding ProcessingWastePercentage, Mode=OneWay, StringFormat={}{0:N2}%}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="Scarto qualità %" Width="115" Binding="{Binding QualityWasteDisplay, Mode=OneWay}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="MC Giacenza" Width="95" Binding="{Binding InventoryCubicMeters, Mode=OneWay, StringFormat=N6}" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTemplateColumn Header="Azioni" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Elimina pacco" Tag="{Binding}" Click="DeletePackage_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="11,6" Margin="5,3"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
