<UserControl x:Class="MagazzinoLegname.Views.MaterialDispatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="DispatchSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="DispatchTableTitleStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceHeaderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="13,13,0,0"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style x:Key="DispatchHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DispatchLeftHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DispatchHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="DispatchCenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DispatchHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DispatchLeftCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="DispatchCenteredCellStyle" TargetType="TextBlock" BasedOn="{StaticResource DispatchLeftCellStyle}">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DispatchOperationBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="MinHeight" Value="108"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DispatchOperationBlockStyle}">
                    <StackPanel>
                        <TextBlock Text="OPERATORE SCARICO" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Operators, Mode=OneWay}" SelectedItem="{Binding SelectedOperator}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DispatchOperationBlockStyle}">
                    <StackPanel>
                        <TextBlock Text="SCANSIONE QR PACCO" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="QrInputBox" Text="{Binding QrInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="QrInput_KeyDown"
                                 FontSize="20" FontWeight="SemiBold" Height="51" Padding="15,9" Margin="0,8,0,0"/>
                        <TextBlock Text="Per il test inserisci un CodicePacco o un QrPayload completo e premi ENTER. Il lettore USB utilizzerà lo stesso flusso." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="2,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource DispatchOperationBlockStyle}">
                    <StackPanel>
                        <TextBlock Text="ESITO" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Text="{Binding FeedbackMessage, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding HasPackage, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,15">
                    <StackPanel><TextBlock Text="DETTAGLIO PACCO" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding CurrentPackage.PackageCode, Mode=OneWay}" FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
                    <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12,7"><TextBlock Text="{Binding CurrentPackage.InventoryStatus, Mode=OneWay}" FontWeight="Bold"/></Border>
                </Grid>
                <UniformGrid Grid.Row="1" Columns="5">
                    <StackPanel Margin="0,0,12,12"><TextBlock Text="MISURA" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding CurrentPackage.OperationalMeasure, Mode=OneWay}" FontSize="20" FontWeight="Bold"/></StackPanel>
                    <StackPanel Margin="0,0,12,12"><TextBlock Text="FORNITORE" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding CurrentPackage.SupplierName, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Margin="0,0,12,12"><TextBlock Text="CARICO" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding CurrentPackage.LoadNumber, Mode=OneWay}" FontWeight="Bold"/></StackPanel>
                    <StackPanel Margin="0,0,12,12"><TextBlock Text="PACCO" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding CurrentPackage.PackagePosition, Mode=OneWay}" FontWeight="Bold"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="DATA ARRIVO" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding CurrentPackage.ArrivalDate, Mode=OneWay, StringFormat=dd/MM/yyyy}" FontWeight="Bold"/></StackPanel>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="QUALITÀ" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding CurrentPackage.Quality, Mode=OneWay}" FontWeight="Bold"/></StackPanel>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="CERTIFICAZIONE" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding CurrentPackage.Certification, Mode=OneWay}" FontWeight="Bold"/></StackPanel>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="CLASSIFICAZIONE" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding CurrentPackage.ClassificationStatus, Mode=OneWay}" FontWeight="Bold"/></StackPanel>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="RETTIFICA SCARTI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding CurrentPackage.WasteAdjustmentStatus, Mode=OneWay}" FontSize="18" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="MC GIACENZA" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding CurrentPackage.InventoryCubicMetersDisplay, Mode=OneWay}" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
                </UniformGrid>
                <Grid Grid.Row="2" Margin="0,17,0,0">
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DischargeAmountText, Mode=OneWay}" FontSize="17" FontWeight="Bold"/><TextBlock Text="{Binding PreviousDischargeDetail, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Annulla" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0,0,9,0"/><Button Content="{Binding ConfirmButtonText, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanDischarge}" Click="Confirm_Click"/></StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource DispatchTableTitleStyle}"><StackPanel><TextBlock Text="ULTIMI SCARICHI" Style="{StaticResource DispatchSectionTitleStyle}"/><TextBlock Text="Ultime operazioni effettuate durante questa sessione" Style="{StaticResource PageSubtitleStyle}"/></StackPanel></Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding RecentDischarges, Mode=OneWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="38">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DispatchHeaderStyle}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ora" Width="90" Binding="{Binding Date, Mode=OneWay, StringFormat=HH:mm:ss}" HeaderStyle="{StaticResource DispatchCenteredHeaderStyle}" ElementStyle="{StaticResource DispatchCenteredCellStyle}"/>
                        <DataGridTextColumn Header="Codice pacco" Width="220" Binding="{Binding PackageCode, Mode=OneWay}" HeaderStyle="{StaticResource DispatchLeftHeaderStyle}" ElementStyle="{StaticResource DispatchLeftCellStyle}"/>
                        <DataGridTextColumn Header="Fornitore" Width="*" MinWidth="220" Binding="{Binding SupplierName, Mode=OneWay}" HeaderStyle="{StaticResource DispatchLeftHeaderStyle}" ElementStyle="{StaticResource DispatchLeftCellStyle}"/>
                        <DataGridTextColumn Header="Carico" Width="90" Binding="{Binding LoadNumber, Mode=OneWay}" HeaderStyle="{StaticResource DispatchCenteredHeaderStyle}" ElementStyle="{StaticResource DispatchCenteredCellStyle}"/>
                        <DataGridTextColumn Header="MC scaricati" Width="120" Binding="{Binding CubicMeters, Mode=OneWay, TargetNullValue=—, StringFormat=N2}" HeaderStyle="{StaticResource DispatchCenteredHeaderStyle}" ElementStyle="{StaticResource DispatchCenteredCellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
