<Window x:Class="MagazzinoLegname.Views.ManualPackageRemovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rimozione manuale pacco" Width="470" Height="410"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Inter, Segoe UI">
    <Border Style="{StaticResource CardStyle}" Margin="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Rimozione manuale" FontSize="22" FontWeight="ExtraBold"/>
            <TextBlock Grid.Row="1" x:Name="PackageText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,18"/>
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="OPERATORE" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="OperatorCombo" SelectedIndex="0"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="MOTIVO" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="ReasonCombo" SelectedIndex="0">
                    <ComboBoxItem Content="Errore inserimento"/><ComboBoxItem Content="Rettifica inventario"/>
                    <ComboBoxItem Content="Pacco non presente"/><ComboBoxItem Content="Altro"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="4">
                <TextBlock Text="NOTA (OBBLIGATORIA SE ALTRO)" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="NoteTextBox" MaxLength="180" AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Annulla" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0"/>
                <Button Content="Conferma rimozione" Click="Confirm_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
