<Window x:Class="MagazzinoLegname.Views.PrintConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conferma stampa" Width="520" Height="250" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Inter, Segoe UI">
    <Border Style="{StaticResource CardStyle}" Margin="18">
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Le etichette sono state stampate correttamente?" FontSize="20" FontWeight="ExtraBold" TextWrapping="Wrap"/><TextBlock Text="Se la stampa non è riuscita verranno riutilizzati gli stessi pacchi, codici e QR." Style="{StaticResource PageSubtitleStyle}" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="NO, RISTAMPA" Style="{StaticResource SecondaryButtonStyle}" Click="Reprint_Click" Margin="0,0,9,0"/><Button Content="SÌ, STAMPA OK" Style="{StaticResource PrimaryButtonStyle}" Click="PrintOk_Click"/></StackPanel>
        </Grid>
    </Border>
</Window>
