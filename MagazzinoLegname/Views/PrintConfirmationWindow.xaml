<Window x:Class="MagazzinoLegname.Views.PrintConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conferma stampa" Width="570" Height="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Inter, Segoe UI">
    <Border Style="{StaticResource CardStyle}" Margin="18" Padding="24">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470">
                <TextBlock Text="Le etichette sono state stampate correttamente?" FontSize="21" FontWeight="ExtraBold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Text="Se la stampa non è riuscita verranno riutilizzati gli stessi pacchi, codici e QR." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" LineHeight="19" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0"><Button Content="NO, RISTAMPA" Style="{StaticResource SecondaryButtonStyle}" Click="Reprint_Click" Margin="0,0,10,0"/><Button Content="SÌ, STAMPA OK" Style="{StaticResource PrimaryButtonStyle}" Click="PrintOk_Click"/></StackPanel>
        </Grid>
    </Border>
</Window>
