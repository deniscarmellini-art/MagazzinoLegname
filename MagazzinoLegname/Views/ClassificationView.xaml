<UserControl x:Class="MagazzinoLegname.Views.ClassificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CenteredGridText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ClassificationHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClassificationTitleBarStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceHeaderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="13,13,0,0"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="390"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,14" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource ClassificationTitleBarStyle}">
                    <StackPanel><TextBlock Text="CARICHI DA COMPLETARE" FontWeight="Bold"/><TextBlock Text="Seleziona il carico e assegna l’operatore che eseguirà la classificazione" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleLoads}" SelectedItem="{Binding SelectedLoad}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionUnit="FullRow" RowHeight="38" ColumnHeaderStyle="{StaticResource ClassificationHeaderStyle}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ClassificationHeaderStyle}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Numero carico" Width="125" Binding="{Binding LoadNumber, Mode=OneWay}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Fornitore" Width="260" Binding="{Binding SupplierName, Mode=OneWay}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Data arrivo" Width="125" Binding="{Binding ArrivalDate, Mode=OneWay, StringFormat=dd/MM/yyyy}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Totale pacchi" Width="115" Binding="{Binding TotalPackages, Mode=OneWay}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Da classificare" Width="130" Binding="{Binding PackagesToClassify, Mode=OneWay}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Classificati" Width="110" Binding="{Binding ClassifiedPackages, Mode=OneWay}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Stato carico" Width="195" Binding="{Binding Status, Mode=OneWay}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTemplateColumn Header="Operatore" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Operators, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding SelectedOperator, UpdateSourceTrigger=PropertyChanged}"
                                              Height="30" Margin="5,2" Padding="8,2" FontSize="14"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True" MinHeight="250">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource ClassificationTitleBarStyle}">
                    <StackPanel><TextBlock FontSize="18" FontWeight="Bold"><Run Text="Gruppi materiale · carico "/><Run Text="{Binding SelectedLoad.LoadNumber, Mode=OneWay}"/></TextBlock><TextBlock Text="Ogni gruppo può essere completato indipendentemente dagli altri." Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding OperationalGroups}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" SelectionUnit="FullRow" RowHeight="54"
                          ColumnHeaderStyle="{StaticResource ClassificationHeaderStyle}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ClassificationHeaderStyle}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Spessore ingresso" Width="125" Binding="{Binding IncomingThickness, Mode=OneWay, StringFormat=N2}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Convenzionale" Width="115" Binding="{Binding ConventionalThickness, Mode=OneWay, StringFormat=N2}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Larghezza ingresso" Width="135" Binding="{Binding IncomingWidth, Mode=OneWay, StringFormat=N2}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Dopo prepiall." Width="125" Binding="{Binding WidthAfterPlaning, Mode=OneWay, StringFormat=N2}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Lunghezza" Width="110" Binding="{Binding IncomingLength, Mode=OneWay, StringFormat=N2}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Qualità" Width="80" Binding="{Binding Quality, Mode=OneWay}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Pacchi" Width="80" Binding="{Binding PackageCount, Mode=OneWay}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Pezzi iniziali" Width="110" Binding="{Binding InitialPieces, Mode=OneWay}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTextColumn Header="Stato classificazione" Width="220" Binding="{Binding ClassificationStatus, Mode=OneWay}" ElementStyle="{StaticResource CenteredGridText}"/>
                        <DataGridTemplateColumn Header="Etichette e azioni" Width="520">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5,2">
                                        <Button Content="Avvia e stampa" Tag="{Binding}" Click="StartOfficialLabels_Click" Padding="10,6" Margin="0,0,6,0" ToolTip="Stampa le etichette ufficiali P01...Pxx al primo avvio">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding OfficialLabelsPrinted}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsClassified}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="Ristampa" Tag="{Binding}" Click="ReprintOfficialLabels_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,6,0" ToolTip="Ristampa le etichette ufficiali senza creare pacchi"/>
                                        <Button Content="+ Supplementare" Tag="{Binding}" Click="AddSupplementaryLabel_Click" Padding="10,6" Margin="0,0,6,0" ToolTip="Crea e stampa una sola etichetta Sxx senza MC contabili">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsClassified}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="Ristampa suppl." Tag="{Binding}" Click="ReprintSupplementaryLabels_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,6,0" ToolTip="Ristampa le supplementari già create senza generarne di nuove"/>
                                        <Button Content="Classificato" Tag="{Binding}" Click="MarkClassified_Click" Padding="10,6">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsClassified}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="↶" Tag="{Binding}" Click="UndoClassification_Click" Padding="10,6" ToolTip="Riporta il gruppo allo stato Da classificare">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanUndoClassification}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" Background="#101A24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,10"><TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Text="La classificazione registra l’operatore selezionato sul carico e la data/ora. Non modifica pezzi o metri cubi e non richiede dati di scarto."/></Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
