<UserControl x:Class="MagazzinoLegname.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="HistoryCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="10,0,6,0"/>
        </Style>
        <Style x:Key="HistoryCenteredCellStyle" TargetType="TextBlock" BasedOn="{StaticResource HistoryCellStyle}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
        <Style x:Key="HistoryNumericCellStyle" TargetType="TextBlock" BasedOn="{StaticResource HistoryCellStyle}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="6,0,12,0"/>
        </Style>
        <Style x:Key="HistoryLeftHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,11,6,11"/>
        </Style>
        <Style x:Key="HistoryCenteredHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,11"/>
        </Style>
        <Style x:Key="HistoryNumericHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,11,12,11"/>
        </Style>
        <Style x:Key="HistoryTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{DynamicResource SurfaceHeaderBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0"
                                CornerRadius="7,7,0,0" Padding="13,6" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#29333E"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="10">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20,4,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="7"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="11,9" Margin="0,0,0,7">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FILTRI RAPIDI" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Tutti" Tag="Tutti" Click="QuickFilter_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5" Margin="0,0,6,0"/>
                        <Button Content="Entrate" Tag="Entrate" Click="QuickFilter_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5" Margin="0,0,6,0"/>
                        <Button Content="Rettifiche" Tag="Rettifiche" Click="QuickFilter_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5" Margin="0,0,6,0"/>
                        <Button Content="Scarichi" Tag="Scarichi" Click="QuickFilter_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5" Margin="0,0,6,0"/>
                        <Button Content="Resi" Tag="Resi" Click="QuickFilter_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5" Margin="0,0,6,0"/>
                        <Button Content="Rimozioni manuali" Tag="Rimozioni manuali" Click="QuickFilter_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuickFilter, StringFormat=Vista: {0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="0.75*"/>
                        <ColumnDefinition Width="1.05*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="DA DATA" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding FromDate}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="A DATA" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding ToDate}"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="FORNITORE" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"/></StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="TIPO MOVIMENTO" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding MovementTypes}" SelectedItem="{Binding SelectedMovementType}"/></StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,8,0"><TextBlock Text="SPESSORE" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Thicknesses}" SelectedItem="{Binding SelectedThickness}"/></StackPanel>
                    <StackPanel Grid.Column="5" Margin="0,0,8,0"><TextBlock Text="QUALITÀ" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}"/></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="OPERATORE" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}"/></StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding VisibleMovements}" SelectedItem="{Binding SelectedMovement}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="39">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data/Ora" Width="125" Binding="{Binding DateTime, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=—}" ElementStyle="{StaticResource HistoryCellStyle}" HeaderStyle="{StaticResource HistoryLeftHeaderStyle}"/>
                    <DataGridTextColumn Header="Tipo movimento" Width="145" Binding="{Binding MovementType}" ElementStyle="{StaticResource HistoryCellStyle}" HeaderStyle="{StaticResource HistoryLeftHeaderStyle}"/>
                    <DataGridTemplateColumn Header="Carico" Width="145" MinWidth="135" HeaderStyle="{StaticResource HistoryLeftHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding LoadNumber}" Tag="{Binding LoadId}" Click="LoadHistory_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="7,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="{DynamicResource AccentBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Fornitore" Width="1.35*" MinWidth="165" Binding="{Binding SupplierName}" ElementStyle="{StaticResource HistoryCellStyle}" HeaderStyle="{StaticResource HistoryLeftHeaderStyle}"/>
                    <DataGridTextColumn Header="Materiale" Width="1.15*" MinWidth="145" Binding="{Binding Material}" ElementStyle="{StaticResource HistoryCellStyle}" HeaderStyle="{StaticResource HistoryLeftHeaderStyle}"/>
                    <DataGridTextColumn Header="Qualità" Width="70" Binding="{Binding Quality, TargetNullValue=—}" ElementStyle="{StaticResource HistoryCenteredCellStyle}" HeaderStyle="{StaticResource HistoryCenteredHeaderStyle}"/>
                    <DataGridTextColumn Header="Pacco/Pacchi" Width="115" Binding="{Binding PackageDisplay}" ElementStyle="{StaticResource HistoryCenteredCellStyle}" HeaderStyle="{StaticResource HistoryCenteredHeaderStyle}"/>
                    <DataGridTextColumn Header="MC movimento" Width="110" Binding="{Binding CubicMetersDisplay}" ElementStyle="{StaticResource HistoryNumericCellStyle}" HeaderStyle="{StaticResource HistoryNumericHeaderStyle}"/>
                    <DataGridTextColumn Header="Operatore" Width="125" Binding="{Binding Operator, TargetNullValue=—}" ElementStyle="{StaticResource HistoryCellStyle}" HeaderStyle="{StaticResource HistoryLeftHeaderStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <GridSplitter Grid.Row="2" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,9,0" Padding="13">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="DETTAGLIO MOVIMENTO" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <Grid Grid.Row="1" Margin="0,9,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,10,7"><TextBlock Text="NUMERO CARICO" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedMovement.LoadNumber, TargetNullValue=—}" FontWeight="Bold"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,7"><TextBlock Text="NUMERO DDT" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedMovement.DeliveryNoteNumber, TargetNullValue=—}" FontWeight="Bold"/></StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,10,7"><TextBlock Text="FORNITORE" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedMovement.SupplierName, TargetNullValue=—}" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,7"><TextBlock Text="DATA / ORA" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedMovement.DateTime, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=—}" FontWeight="Bold"/></StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,10,0"><TextBlock Text="OPERATORE" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedMovement.Operator, TargetNullValue=—}" FontWeight="Bold"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="TIPO MOVIMENTO" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedMovement.MovementType, TargetNullValue=—}" FontWeight="Bold"/></StackPanel>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SelectedMovement.DetailText, TargetNullValue=Seleziona un movimento per visualizzarne lo snapshot.}" TextWrapping="Wrap" LineHeight="19"/></ScrollViewer>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="13">
                <Grid>
                    <TextBlock Text="Seleziona il numero di un carico per aprirne la storia completa." Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid Visibility="{Binding IsLoadHistoryVisible, Converter={StaticResource BoolToVisibility}}" Background="{DynamicResource SurfaceBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><StackPanel><TextBlock Text="{Binding SelectedLoadSummary.LoadNumber, StringFormat=STORIA CARICO {0}}" FontSize="17" FontWeight="ExtraBold"/><TextBlock Text="{Binding SelectedLoadSummary.SupplierName}" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel><Button Content="Chiudi" Click="CloseLoadHistory_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,5"/></Grid>
                        <UniformGrid Grid.Row="1" Columns="5" Margin="0,8">
                            <StackPanel><TextBlock Text="INIZIALI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedLoadSummary.InitialPackages}" FontWeight="Bold"/></StackPanel>
                            <StackPanel><TextBlock Text="PRESENTI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedLoadSummary.PresentPackages}" FontWeight="Bold"/></StackPanel>
                            <StackPanel><TextBlock Text="SCARICATI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedLoadSummary.DischargedPackages}" FontWeight="Bold"/></StackPanel>
                            <StackPanel><TextBlock Text="RIMOSSI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedLoadSummary.ManuallyRemovedPackages}" FontWeight="Bold"/></StackPanel>
                            <StackPanel><TextBlock Text="MC PRESENTI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedLoadSummary.PresentCubicMeters, StringFormat=N2}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
                        </UniformGrid>
                        <TabControl Grid.Row="2" Style="{StaticResource HistoryTabControlStyle}"
                                    ItemContainerStyle="{StaticResource HistoryTabItemStyle}">
                            <TabItem Header="Cronologia"><DataGrid ItemsSource="{Binding LoadTimeline}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Data/Ora" Width="125" Binding="{Binding DateTime, StringFormat=dd/MM/yyyy HH:mm}"/><DataGridTextColumn Header="Movimento" Width="150" Binding="{Binding MovementType}"/><DataGridTextColumn Header="MC" Width="85" Binding="{Binding CubicMetersDisplay}"/><DataGridTextColumn Header="Operatore" Width="*" Binding="{Binding Operator}"/></DataGrid.Columns></DataGrid></TabItem>
                            <TabItem Header="Pacchi"><DataGrid ItemsSource="{Binding LoadPackages}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Codice pacco" Width="135" Binding="{Binding PackageCode}"/><DataGridTextColumn Header="Pacco" Width="65" Binding="{Binding Position}"/><DataGridTextColumn Header="Qualità" Width="65" Binding="{Binding Quality}"/><DataGridTextColumn Header="Misura" Width="*" Binding="{Binding Measure}"/><DataGridTextColumn Header="Stato" Width="145" Binding="{Binding Status}"/><DataGridTextColumn Header="Data evento" Width="115" Binding="{Binding EventDate, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=—}"/><DataGridTextColumn Header="MC" Width="75" Binding="{Binding EventCubicMeters, StringFormat=N2, TargetNullValue=—}"/><DataGridTextColumn Header="Motivo" Width="130" Binding="{Binding Reason, TargetNullValue=—}"/></DataGrid.Columns></DataGrid></TabItem>
                            <TabItem Header="Totali"><UniformGrid Columns="3" Margin="12"><StackPanel Margin="6"><TextBlock Text="MC FISICI ENTRATI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedLoadSummary.IncomingCubicMeters, StringFormat=N2}" FontSize="16" FontWeight="Bold"/></StackPanel><StackPanel Margin="6"><TextBlock Text="MC UTILI TEORICI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedLoadSummary.TheoreticalCubicMeters, StringFormat=N2}" FontSize="16" FontWeight="Bold"/></StackPanel><StackPanel Margin="6"><TextBlock Text="MC REALI RETTIFICATI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedLoadSummary.RealCubicMeters, StringFormat=N2}" FontSize="16" FontWeight="Bold"/></StackPanel><StackPanel Margin="6"><TextBlock Text="MC SCARICATI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedLoadSummary.DischargedCubicMeters, StringFormat=N2}" FontSize="16" FontWeight="Bold"/></StackPanel><StackPanel Margin="6"><TextBlock Text="MC RIMOSSI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedLoadSummary.ManuallyRemovedCubicMeters, StringFormat=N2}" FontSize="16" FontWeight="Bold"/></StackPanel><StackPanel Margin="6"><TextBlock Text="MC PRESENTI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedLoadSummary.PresentCubicMeters, StringFormat=N2}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></UniformGrid></TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
