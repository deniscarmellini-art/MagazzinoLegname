<UserControl x:Class="MagazzinoLegname.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="StatisticsCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="StatisticsCenteredCellStyle" TargetType="TextBlock" BasedOn="{StaticResource StatisticsCellStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatisticsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatisticsSectionHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHeaderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="StatisticsTableTitleHeaderStyle" TargetType="Border" BasedOn="{StaticResource StatisticsSectionHeaderStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceHeaderBrush}"/>
            <Setter Property="CornerRadius" Value="13,13,0,0"/>
        </Style>
        <Style x:Key="StatisticsTableBodyStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="0,0,13,13"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="StatisticsCompactHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatisticsCompactGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource StatisticsCompactHeaderStyle}"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>
        <Style x:Key="StatisticsChartStyle" TargetType="{x:Type lvc:CartesianChart}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="LegendPosition" Value="Top"/>
            <Setter Property="LegendBackgroundPaint" Value="#131B25"/>
            <Setter Property="LegendTextPaint" Value="#E6EDF5"/>
            <Setter Property="LegendTextSize" Value="12"/>
            <Setter Property="TooltipPosition" Value="Top"/>
            <Setter Property="TooltipBackgroundPaint" Value="#253443"/>
            <Setter Property="TooltipTextPaint" Value="#F4F7FA"/>
            <Setter Property="TooltipTextSize" Value="12"/>
            <Setter Property="MinHeight" Value="228"/>
        </Style>
        <Style x:Key="StatisticsChartCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Height" Value="300"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="StatisticsChartHeaderStyle" TargetType="Border" BasedOn="{StaticResource StatisticsSectionHeaderStyle}">
            <Setter Property="CornerRadius" Value="13,13,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,12">
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="PERIODO" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"/></StackPanel>
                    <StackPanel Grid.Column="1" Width="145" Margin="0,0,10,0" Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="DATA DA" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding DateFrom}"/></StackPanel>
                    <StackPanel Grid.Column="2" Width="145" Margin="0,0,12,0" Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="DATA A" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding DateTo}"/></StackPanel>
                    <Grid Grid.Column="3" Margin="0,0,12,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="FORNITORE" Style="{StaticResource FieldLabelStyle}"/>
                            <CheckBox Content="Includi inattivi" IsChecked="{Binding IncludeInactiveSuppliers}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                        </Grid>
                        <ComboBox Grid.Row="1" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"/>
                    </Grid>
                    <StackPanel Grid.Column="4" Margin="0,0,12,0"><TextBlock Text="SPESSORE" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Thicknesses}" SelectedItem="{Binding SelectedThickness}"/></StackPanel>
                    <StackPanel Grid.Column="5"><TextBlock Text="QUALITÀ" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}"/></StackPanel>
                </Grid>
            </Border>

            <UniformGrid Rows="1" Margin="-6,0,-6,14">
                <Border Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="MC ENTRATI" FontWeight="Bold"/><TextBlock Text="{Binding CubicMetersEnteredDisplay}" FontSize="29" FontWeight="ExtraBold" Margin="0,12,0,0"/><TextBlock Text="MC fisici nel periodo" Style="{StaticResource PageSubtitleStyle}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="MC REALI POST CLASSIFICAZIONE" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding RealCubicMetersAfterClassificationDisplay}" FontSize="29" FontWeight="ExtraBold" Margin="0,12,0,0"/><TextBlock Text="da rettifiche scarti" Style="{StaticResource PageSubtitleStyle}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="MC SCARICATI" FontWeight="Bold"/><TextBlock Text="{Binding CubicMetersDischargedDisplay}" FontSize="29" FontWeight="ExtraBold" Margin="0,12,0,0"/><TextBlock Text="movimenti di scarico" Style="{StaticResource PageSubtitleStyle}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="MC RESI" FontWeight="Bold"/><TextBlock Text="{Binding CubicMetersReturnedDisplay}" FontSize="29" FontWeight="ExtraBold" Margin="0,12,0,0"/><TextBlock Text="MC fisici resi" Style="{StaticResource PageSubtitleStyle}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="SCARTO QUALITÀ MEDIO" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding AverageQualityWasteDisplay}" FontSize="29" FontWeight="ExtraBold" Margin="0,12,0,0"/><TextBlock Text="media ponderata" Style="{StaticResource PageSubtitleStyle}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="SFRIDO LAVORAZIONI MEDIO" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding AverageProcessingWasteDisplay}" FontSize="29" FontWeight="ExtraBold" Margin="0,12,0,0"/><TextBlock Text="media ponderata" Style="{StaticResource PageSubtitleStyle}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="VALORE ACQUISTI" FontWeight="Bold"/><TextBlock Text="{Binding PurchaseValueDisplay}" FontSize="29" FontWeight="ExtraBold" Margin="0,12,0,0"/><TextBlock Text="prezzi applicati storici" Style="{StaticResource PageSubtitleStyle}"/></StackPanel></Border>
            </UniformGrid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,7,0" ClipToBounds="True">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource StatisticsTableTitleHeaderStyle}"><TextBlock Text="ANALISI FORNITORI" Style="{StaticResource StatisticsSectionTitleStyle}"/></Border>
                        <Border Grid.Row="1" Style="{StaticResource StatisticsTableBodyStyle}">
                        <DataGrid Style="{StaticResource StatisticsCompactGridStyle}" ItemsSource="{Binding SupplierRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fornitore" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="210" Binding="{Binding SupplierName, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCellStyle}"/>
                                <DataGridTextColumn Header="MC acquistati" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="*" MinWidth="120" Binding="{Binding PurchasedCubicMetersDisplay, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                                <DataGridTextColumn Header="MC resi" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="*" MinWidth="100" Binding="{Binding ReturnedCubicMetersDisplay, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                                <DataGridTextColumn Header="Valore €" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="1.1*" MinWidth="125" Binding="{Binding ValueDisplay, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                                <DataGridTextColumn Header="Prezzo medio ponderato €/m³" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="1.65*" MinWidth="190" Binding="{Binding WeightedAveragePriceDisplay, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                                <DataGridTextColumn Header="Scarto qualità %" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="1.15*" MinWidth="130" Binding="{Binding QualityWasteDisplay, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                                <DataGridTextColumn Header="Sfrido lavorazioni %" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="1.3*" MinWidth="145" Binding="{Binding ProcessingWasteDisplay, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0" Margin="7,0,0,0" ClipToBounds="True">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource StatisticsTableTitleHeaderStyle}"><TextBlock Text="SCARTO QUALITÀ PER FORNITORE E MATERIALE" Style="{StaticResource StatisticsSectionTitleStyle}"/></Border>
                        <Border Grid.Row="1" Style="{StaticResource StatisticsTableBodyStyle}">
                        <DataGrid Style="{StaticResource StatisticsCompactGridStyle}" ItemsSource="{Binding QualityWasteRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fornitore" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="180" Binding="{Binding SupplierName, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCellStyle}"/>
                                <DataGridTextColumn Header="23 C" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="*" MinWidth="50" Binding="{Binding Thickness23C, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                                <DataGridTextColumn Header="23 VISTA" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="1.35*" MinWidth="68" Binding="{Binding Thickness23Vista, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                                <DataGridTextColumn Header="34 C" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="*" MinWidth="50" Binding="{Binding Thickness34C, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                                <DataGridTextColumn Header="34 VISTA" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="1.35*" MinWidth="68" Binding="{Binding Thickness34Vista, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                                <DataGridTextColumn Header="44 C" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="*" MinWidth="50" Binding="{Binding Thickness44C, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                                <DataGridTextColumn Header="44 VISTA" HeaderStyle="{StaticResource StatisticsCompactHeaderStyle}" Width="1.35*" MinWidth="68" Binding="{Binding Thickness44Vista, Mode=OneWay}" ElementStyle="{StaticResource StatisticsCenteredCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="-6,0,-6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource StatisticsChartCardStyle}" Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource StatisticsChartHeaderStyle}">
                            <Grid>
                                <TextBlock Text="ENTRATE VS SCARICHI NEL TEMPO" Style="{StaticResource StatisticsSectionTitleStyle}"/>
                                <TextBlock Text="{Binding TimeChartGranularity}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                            </Grid>
                        </Border>
                        <lvc:CartesianChart Grid.Row="1" Style="{StaticResource StatisticsChartStyle}" Margin="8,2,8,8"
                                            Series="{Binding TimeChartSeries}"
                                            XAxes="{Binding TimeChartXAxes}"
                                            YAxes="{Binding TimeChartYAxes}"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatisticsChartCardStyle}" Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource StatisticsChartHeaderStyle}"><TextBlock Text="SCARTO QUALITÀ PER FORNITORE" Style="{StaticResource StatisticsSectionTitleStyle}"/></Border>
                        <Grid Grid.Row="1">
                            <lvc:CartesianChart Style="{StaticResource StatisticsChartStyle}" Margin="8,2,8,8"
                                                Series="{Binding SupplierQualityWasteChartSeries}"
                                                XAxes="{Binding SupplierQualityWasteChartXAxes}"
                                                YAxes="{Binding SupplierQualityWasteChartYAxes}"/>
                            <TextBlock Text="Nessuna rettifica scarti disponibile nel periodo"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SupplierQualityWastePoints.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatisticsChartCardStyle}" Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource StatisticsChartHeaderStyle}"><TextBlock Text="MC ACQUISTATI PER FORNITORE" Style="{StaticResource StatisticsSectionTitleStyle}"/></Border>
                        <Grid Grid.Row="1">
                            <lvc:CartesianChart Style="{StaticResource StatisticsChartStyle}" Margin="8,2,8,8"
                                                Series="{Binding SupplierPurchaseChartSeries}"
                                                XAxes="{Binding SupplierPurchaseChartXAxes}"
                                                YAxes="{Binding SupplierPurchaseChartYAxes}"/>
                            <TextBlock Text="Nessun acquisto nel periodo selezionato"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SupplierPurchasePoints.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
