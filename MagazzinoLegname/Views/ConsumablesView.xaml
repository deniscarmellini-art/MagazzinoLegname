<UserControl x:Class="MagazzinoLegname.Views.ConsumablesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:MagazzinoLegname.Models" xmlns:behaviors="clr-namespace:MagazzinoLegname.Behaviors">
 <UserControl.Resources>
  <Style x:Key="ConsumableKpiStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Padding" Value="15,11"/><Setter Property="Margin" Value="5"/></Style>
  <Style x:Key="ConsumableKpiValueStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="ExtraBold"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
  <Style x:Key="ConsumableHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}"/>
  <Style x:Key="ConsumablesTabItemStyle" TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="FontFamily" Value="Inter, Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="20,9" Margin="0,0,7,8"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#29333E"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ConsumablesTabControlStyle" TargetType="TabControl">
   <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ItemContainerStyle" Value="{StaticResource ConsumablesTabItemStyle}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid Background="{TemplateBinding Background}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True" Background="Transparent"/><Border Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}" BorderThickness="0"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ConsumablesHeaderLeftStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="FontFamily" Value="Inter, Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,0"/></Style>
  <Style x:Key="ConsumablesHeaderCenterStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ConsumablesHeaderLeftStyle}"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="5,0"/></Style>
  <Style x:Key="ConsumablesCellLeftStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Inter, Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="10,0,6,0"/></Style>
  <Style x:Key="ConsumablesCellCenterStyle" TargetType="TextBlock" BasedOn="{StaticResource ConsumablesCellLeftStyle}"><Setter Property="TextAlignment" Value="Center"/><Setter Property="Margin" Value="5,0"/></Style>
 </UserControl.Resources>
 <Grid Background="{DynamicResource AppBackgroundBrush}"><TabControl Margin="20,5,20,16" Style="{StaticResource ConsumablesTabControlStyle}">
  <TabItem Header="Situazione">
   <Grid Margin="8" Background="{DynamicResource AppBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <UniformGrid Columns="5" Margin="-5,0,-5,9">
     <Border Style="{StaticResource ConsumableKpiStyle}"><StackPanel><TextBlock Text="ARTICOLI ATTIVI" Style="{StaticResource ConsumableHeaderStyle}"/><TextBlock Text="{Binding ActiveItems}" Style="{StaticResource ConsumableKpiValueStyle}"/></StackPanel></Border>
     <Border Style="{StaticResource ConsumableKpiStyle}"><StackPanel><TextBlock Text="SOTTO SCORTA" Style="{StaticResource ConsumableHeaderStyle}"/><TextBlock Text="{Binding BelowMinimum}" Style="{StaticResource ConsumableKpiValueStyle}"/></StackPanel></Border>
     <Border Style="{StaticResource ConsumableKpiStyle}"><StackPanel><TextBlock Text="DA ORDINARE" Style="{StaticResource ConsumableHeaderStyle}"/><TextBlock Text="{Binding ToOrder}" Style="{StaticResource ConsumableKpiValueStyle}"/></StackPanel></Border>
     <Border Style="{StaticResource ConsumableKpiStyle}"><StackPanel><TextBlock Text="IN ORDINE" Style="{StaticResource ConsumableHeaderStyle}"/><TextBlock Text="{Binding Ordered}" Style="{StaticResource ConsumableKpiValueStyle}"/></StackPanel></Border>
     <Border Style="{StaticResource ConsumableKpiStyle}"><StackPanel><TextBlock Text="DA VERIFICARE" Style="{StaticResource ConsumableHeaderStyle}"/><TextBlock Text="{Binding ToVerify}" Style="{StaticResource ConsumableKpiValueStyle}"/></StackPanel></Border>
    </UniformGrid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0"><TextBlock Text="RICERCA PRODOTTO" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="FORNITORE" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="REPARTO / UTILIZZO" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}"/></StackPanel>
     <StackPanel Grid.Column="3"><TextBlock Text="STATO" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Row="2">
    <DataGrid x:Name="SituationGrid" ItemsSource="{Binding SituationRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="42" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="Foto" Width="58" HeaderStyle="{StaticResource ConsumablesHeaderCenterStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding PhotoPath}" Width="34" Height="34" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Prodotto" Width="1.8*" MinWidth="160" Binding="{Binding ProductName}" IsReadOnly="True" HeaderStyle="{StaticResource ConsumablesHeaderLeftStyle}" ElementStyle="{StaticResource ConsumablesCellLeftStyle}"/>
      <DataGridTextColumn Header="Utilizzo / Reparto" Width="1.25*" MinWidth="145" Binding="{Binding Department}" IsReadOnly="True" HeaderStyle="{StaticResource ConsumablesHeaderLeftStyle}" ElementStyle="{StaticResource ConsumablesCellLeftStyle}"/>
      <DataGridTextColumn Header="Fornitore" Width="1.15*" MinWidth="135" Binding="{Binding SupplierName}" IsReadOnly="True" HeaderStyle="{StaticResource ConsumablesHeaderLeftStyle}" ElementStyle="{StaticResource ConsumablesCellLeftStyle}"/>
      <DataGridTextColumn Header="UDM" Width="65" Binding="{Binding UnitOfMeasure}" IsReadOnly="True" HeaderStyle="{StaticResource ConsumablesHeaderCenterStyle}" ElementStyle="{StaticResource ConsumablesCellCenterStyle}"/>
      <DataGridTextColumn Header="Giacenza" Width="90" Binding="{Binding CurrentStockDisplay}" IsReadOnly="True" HeaderStyle="{StaticResource ConsumablesHeaderCenterStyle}" ElementStyle="{StaticResource ConsumablesCellCenterStyle}"/>
      <DataGridTextColumn Header="Scorta min." Width="90" Binding="{Binding MinimumStockDisplay}" IsReadOnly="True" HeaderStyle="{StaticResource ConsumablesHeaderCenterStyle}" ElementStyle="{StaticResource ConsumablesCellCenterStyle}"/>
      <DataGridTextColumn Header="Consumo medio" Width="1*" MinWidth="115" Binding="{Binding ConsumptionDisplay}" IsReadOnly="True" HeaderStyle="{StaticResource ConsumablesHeaderCenterStyle}" ElementStyle="{StaticResource ConsumablesCellCenterStyle}"/>
      <DataGridTextColumn Header="Quantità in ordine" Width="125" Binding="{Binding OrderedDisplay}" IsReadOnly="True" HeaderStyle="{StaticResource ConsumablesHeaderCenterStyle}" ElementStyle="{StaticResource ConsumablesCellCenterStyle}"/>
      <DataGridTemplateColumn Header="Stato" Width="155" IsReadOnly="True" HeaderStyle="{StaticResource ConsumablesHeaderCenterStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <Border CornerRadius="7" Padding="8,4" Margin="4" HorizontalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#253B2B"/><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConsumableStockStatus.ToOrder}"><Setter Property="Background" Value="#3B2830"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConsumableStockStatus.BelowMinimumOrdered}"><Setter Property="Background" Value="#413224"/><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConsumableStockStatus.Ordered}"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConsumableStockStatus.ToVerify}"><Setter Property="Background" Value="#413224"/><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" TextAlignment="Center"/></Border>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=SituationGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Nessun materiale presente" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Importa lo storico Excel o aggiungi un materiale dalle Impostazioni." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/></StackPanel>
    </Grid>
    <Border Grid.Row="3" Margin="0,9,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=SituationGrid}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <Grid DataContext="{Binding SelectedItem, ElementName=SituationGrid}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{Binding PhotoPath}" Width="58" Height="58" Stretch="UniformToFill" Margin="0,0,12,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="DETTAGLIO MATERIALE" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/><TextBlock Text="{Binding ProductName}" FontSize="18" FontWeight="ExtraBold"/><TextBlock Text="{Binding Item.Packaging, StringFormat=Packaging: {0}, TargetNullValue=Packaging: —}" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel><Button Grid.Column="2" Content="Salva informazioni ordine" Click="SaveOrders_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/></Grid>
      <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0"><TextBlock Text="ULTIMA RILEVAZIONE" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding LatestReadingDisplay}" FontWeight="SemiBold"/><TextBlock Text="{Binding CountedUnitsDisplay, StringFormat=Rilevate: {0}}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding QuantityPerUnitDisplay, StringFormat=Qtà per UDM: {0}}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="QUANTITÀ IN ORDINE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Order.Quantity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="DATA ORDINE" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding Order.OrderDate}"/></StackPanel>
       <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="CONSEGNA PREVISTA" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding Order.ExpectedDeliveryDate}"/></StackPanel>
       <StackPanel Grid.Column="4" Margin="0,0,8,0"><TextBlock Text="STATO ORDINE" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding DataContext.OrderStatuses, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Order.Status, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <StackPanel Grid.Column="5"><TextBlock Text="NOTA ORDINE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Order.Note, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Item.Notes, StringFormat=Note materiale: {0}}"/></StackPanel>
      </Grid>
     </Grid>
    </Border>
   </Grid>
  </TabItem>
  <TabItem Header="Inventario">
   <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="DATA RILEVAZIONE" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding InventoryDate}"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="OPERATORE" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}"/></StackPanel>
     <Grid Grid.Column="2" Margin="16,0,0,0"><TextBlock Text="Compila soltanto gli articoli rilevati. La variazione stock non è un consumo." Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,210,0"/><Button Content="Stampa scheda inventario" Click="PrintInventorySheet_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </Grid></Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryRows}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40">
     <DataGrid.Columns><DataGridTextColumn Header="Prodotto" Width="1.5*" Binding="{Binding ProductName}" IsReadOnly="True"/><DataGridTextColumn Header="Reparto" Width=".9*" Binding="{Binding Department}" IsReadOnly="True"/><DataGridTextColumn Header="UDM" Width="60" Binding="{Binding UnitOfMeasure}" IsReadOnly="True"/><DataGridTextColumn Header="Qtà/UDM" Width="85" Binding="{Binding QuantityPerUnit, StringFormat=N2, TargetNullValue=—}" IsReadOnly="True"/><DataGridTextColumn Header="Rilevazione precedente" Width="135" Binding="{Binding PreviousQuantity, StringFormat=N2, TargetNullValue=—}" IsReadOnly="True"/>
      <DataGridTemplateColumn Header="NUOVA RILEVAZIONE" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding NewQuantityText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBoxStyle}" behaviors:NumericTextBoxBehavior.SelectAllOnFocus="True" Margin="6,3" TextAlignment="Center" ToolTip="Numero di UDM fisicamente rilevate"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Quantità calcolata" Width="125" Binding="{Binding CalculatedQuantityDisplay}" IsReadOnly="True"/><DataGridTextColumn Header="Variazione stock" Width="115" Binding="{Binding VariationDisplay}" IsReadOnly="True"/><DataGridTextColumn Header="Nota" Width="1.2*" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
     </DataGrid.Columns>
    </DataGrid>
    <Button Grid.Row="2" Content="Conferma inventario" Click="ConfirmInventory_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
   </Grid>
  </TabItem>
  <TabItem Header="Storico">
   <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0"><TextBlock Text="DA DATA" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding HistoryFrom}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="A DATA" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding HistoryTo}"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="PRODOTTO" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding HistoryProduct}"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="FORNITORE" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding HistorySupplier}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="REPARTO" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding HistoryDepartment}"/></StackPanel>
    </Grid></Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="39"><DataGrid.Columns>
     <DataGridTextColumn Header="Data" Width="95" Binding="{Binding Date, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Prodotto" Width="1.4*" Binding="{Binding ProductName}"/><DataGridTextColumn Header="Fornitore" Width=".9*" Binding="{Binding SupplierName}"/><DataGridTextColumn Header="Reparto" Width=".9*" Binding="{Binding Department}"/><DataGridTextColumn Header="UDM rilevate" Width="100" Binding="{Binding CountedUnitsDisplay}"/><DataGridTextColumn Header="Qtà/UDM usata" Width="105" Binding="{Binding QuantityPerUnitDisplay}"/><DataGridTextColumn Header="Quantità effettiva" Width="135" Binding="{Binding CalculationDisplay}"/><DataGridTextColumn Header="Variazione stock" Width="110" Binding="{Binding StockVariationDisplay}"/><DataGridTextColumn Header="Operatore" Width="115" Binding="{Binding Operator}"/><DataGridTextColumn Header="Nota" Width="1.1*" Binding="{Binding Note}"/>
    </DataGrid.Columns></DataGrid>
   </Grid>
  </TabItem>
 </TabControl></Grid>
</UserControl>
