<Window x:Class="MagazzinoLegname.Views.QrPackagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anteprima QR pacchi" Width="1120" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Inter, Segoe UI">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock Text="Anteprima QR pacchi" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Un QR distinto per ogni pacco fisico generato dal carico." Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Packages}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Width="330" Margin="0,0,14,14" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Package.PackageCode}" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"><Run Text="Pacco "/><Run Text="{Binding Package.SequenceNumber, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding Package.TotalPackages, Mode=OneWay}"/></TextBlock></StackPanel><Border HorizontalAlignment="Right" Background="White" CornerRadius="7" Padding="7"><Image Source="{Binding QrImage}" Width="150" Height="150" Stretch="Uniform"/></Border></Grid>
                            <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="FORNITORE" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SupplierName}" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="NUMERO CARICO" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding LoadNumber}" FontWeight="Bold"/></StackPanel>
                            </Grid>
                            <TextBlock Text="MISURA INGRESSO" Style="{StaticResource FieldLabelStyle}" Margin="2,12,0,5"/>
                            <TextBlock><Run Text="{Binding Package.IncomingThickness, Mode=OneWay, StringFormat={}{0:0.##}}"/><Run Text=" × "/><Run Text="{Binding Package.IncomingWidth, Mode=OneWay, StringFormat={}{0:0.##}}"/><Run Text=" × "/><Run Text="{Binding Package.IncomingLength, Mode=OneWay, StringFormat={}{0:0.##}}"/><Run Text=" mm"/></TextBlock>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PEZZI INIZIALI" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding Package.PieceCount}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DATA ARRIVO" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding Package.ArrivalDate, StringFormat=dd/MM/yyyy}"/></StackPanel></Grid>
                            <TextBlock Text="PAYLOAD QR" Style="{StaticResource FieldLabelStyle}" Margin="2,12,0,5"/><TextBox Text="{Binding Package.QrPayload, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Chiudi anteprima" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/>
    </Grid>
</Window>
