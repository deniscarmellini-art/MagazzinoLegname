<Window x:Class="MagazzinoLegname.Views.QrPackagePreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MagazzinoLegname.Views"
        Title="Anteprima etichette" Width="1280" Height="860" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Inter, Segoe UI">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16"><StackPanel><TextBlock Text="Anteprima etichette" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Foglio A4 orizzontale • fronte pacco a sinistra • lato pacco a destra" Style="{StaticResource PageSubtitleStyle}"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding PositionText}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="Una pagina per pacco" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right"/></StackPanel></Grid>
        <Border Grid.Row="1" Background="#293440" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><Border Background="White"><views:PackageLabelView DataContext="{Binding CurrentLabel}"/></Border></Viewbox></Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><Button Content="← Precedente" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PreviousCommand}" Margin="0,0,10,0"/><Button Content="Successiva →" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NextCommand}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Chiudi" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click" Margin="0,0,10,0"/><Button Content="Stampa questa etichetta" Style="{StaticResource SecondaryButtonStyle}" Click="PrintCurrent_Click" Margin="0,0,10,0"/><Button Content="Stampa tutte" Style="{StaticResource PrimaryButtonStyle}" Click="PrintAll_Click"/></StackPanel></Grid>
    </Grid>
</Window>
