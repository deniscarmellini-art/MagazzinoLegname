<UserControl x:Class="MagazzinoLegname.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <UniformGrid Rows="1" Margin="-7,0,-7,12">
            <Border Style="{StaticResource CardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="Materiale in ingresso" FontWeight="Bold"/><TextBlock Text="—" FontSize="42" FontWeight="ExtraBold" Margin="0,14,0,0"/><TextBlock Text="in attesa di registrazione" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#3B2830" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DangerBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{StaticResource CardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="Da classificare" FontWeight="Bold"/><TextBlock Text="—" FontSize="42" FontWeight="ExtraBold" Margin="0,14,0,0"/><TextBlock Text="unità da verificare" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#3D3A21" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{StaticResource CardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="Movimenti odierni" FontWeight="Bold"/><TextBlock Text="—" FontSize="42" FontWeight="ExtraBold" Margin="0,14,0,0"/><TextBlock Text="entrate e scarichi" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#413224" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource OrangeBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{StaticResource CardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="Giacenze disponibili" FontWeight="Bold"/><TextBlock Text="—" FontSize="42" FontWeight="ExtraBold" Margin="0,14,0,0"/><TextBlock Text="materiali censiti" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#253B2B" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
        </UniformGrid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource SurfaceHeaderBrush}" CornerRadius="14,14,0,0"><TextBlock Text="ULTIME MOVIMENTAZIONI" Margin="18,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/></Border><StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/><TextBlock Text="Nessun movimento registrato" FontWeight="Bold" Margin="0,12,0,0"/></StackPanel></Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel><TextBlock Text="AZIONI RAPIDE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,14"/><Button Content="Registra entrata merce" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,9"/><Button Content="Apri classificazione" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,9"/><Button Content="Consulta giacenze" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
