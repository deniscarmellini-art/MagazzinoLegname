<UserControl x:Class="MagazzinoLegname.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MagazzinoLegname.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:MovementSignConverter x:Key="MovementSignConverter"/>
        <Style x:Key="DashboardSectionHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHeaderBrush}"/>
            <Setter Property="CornerRadius" Value="13,13,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="DashboardSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="DashboardKpiCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,13"/>
        </Style>
        <Style x:Key="DashboardMovementCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <Style x:Key="DashboardColumnHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashboardHeaderLeftStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource DashboardColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="DashboardHeaderCenterStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource DashboardColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DashboardHeaderRightStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource DashboardColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="DashboardCellLeftStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
        <Style x:Key="DashboardCellCenterStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCellLeftStyle}">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DashboardCellRightStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCellLeftStyle}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <UniformGrid Rows="1" Margin="-7,0,-7,8">
            <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="PACCHI PRESENTI" FontWeight="Bold"/><TextBlock Text="{Binding PresentPackagesDisplay}" FontSize="42" FontWeight="ExtraBold" Margin="0,9,0,0"/><TextBlock Text="pacchi fisicamente presenti" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#3B2830" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="MC GIACENZA" FontWeight="Bold"/><TextBlock Text="{Binding InventoryCubicMetersDisplay}" FontSize="42" FontWeight="ExtraBold" Margin="0,9,0,0"/><TextBlock Text="MC attualmente presenti" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#3D3A21" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="MC DA CONSOLIDARE" FontWeight="Bold"/><TextBlock Text="{Binding CubicMetersToConsolidateDisplay}" FontSize="42" FontWeight="ExtraBold" Margin="0,9,0,0"/><TextBlock Text="MC con rettifica scarti da completare" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#413224" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="MC REALI" FontWeight="Bold"/><TextBlock Text="{Binding RealCubicMetersDisplay}" FontSize="42" FontWeight="ExtraBold" Margin="0,9,0,0"/><TextBlock Text="MC con rettifica scarti completata" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#253B2B" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="VALORE MAGAZZINO" FontWeight="Bold"/><TextBlock Text="{Binding InventoryValueDisplay}" FontSize="42" FontWeight="ExtraBold" Margin="0,9,0,0"/><TextBlock Text="valore complessivo dei pacchi presenti" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#253B2B" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xEAF3;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
        </UniformGrid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- RIGA 2: Giacenza per spessore | Attenzioni operative -->
            <Grid Grid.Row="0" Margin="0,7,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65*"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0" ClipToBounds="True">
                    <StackPanel>
                        <Border Style="{StaticResource DashboardSectionHeaderStyle}"><TextBlock Text="GIACENZA PER SPESSORE" Style="{StaticResource DashboardSectionTitleStyle}"/></Border>
                        <StackPanel>
                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Spessore" FontWeight="Bold" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Qualità C" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Classificati" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Da classificare" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Grid.Column="1" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Qualità VISTA" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Classificati" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Da classificare" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Grid.Column="1" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                            <Border Grid.Column="3" Background="{DynamicResource SurfaceHeaderBrush}" Opacity="0.42"/>
                            <TextBlock Text="Totale" FontWeight="ExtraBold" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ThicknessRows}" Margin="12,0,12,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="1.4*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
                                        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                                        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="{Binding ThicknessDisplay}" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                        <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ClassifiedCDisplay}" FontWeight="Bold" FontSize="14" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ToClassifyCDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Column="2" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ClassifiedVistaDisplay}" FontWeight="Bold" FontSize="14" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ToClassifyVistaDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Grid.Column="3" Background="{DynamicResource SurfaceHeaderBrush}" Opacity="0.24"/>
                                        <TextBlock Text="{Binding TotalAllDisplay}" Grid.Column="3" FontWeight="ExtraBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <StackPanel>
                        <Border Style="{StaticResource DashboardSectionHeaderStyle}"><TextBlock Text="ATTENZIONI OPERATIVE" Style="{StaticResource DashboardSectionTitleStyle}"/></Border>
                        <StackPanel Margin="12,7,12,9">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="200"/><ColumnDefinition Width="18"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#3B2830" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#E5A9B6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Gruppi da classificare" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="su "/><Run Text="{Binding LoadsToClassify, Mode=OneWay}" FontWeight="Bold"/><Run Text=" carichi"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GroupsToClassify}" Grid.Column="3" FontSize="25" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="200"/><ColumnDefinition Width="18"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#413224" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Rettifiche da completare" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="gruppi con scarti da consolidare" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GroupsToConsolidate}" Grid.Column="3" FontSize="25" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGA 3: Ultimi movimenti -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65*"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0" VerticalAlignment="Stretch" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource DashboardSectionHeaderStyle}"><TextBlock Text="ULTIME MOVIMENTAZIONI" Style="{StaticResource DashboardSectionTitleStyle}"/></Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding RecentMovements}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  MaxHeight="280" HorizontalScrollBarVisibility="Auto" RowHeight="34"
                                  ColumnHeaderHeight="42" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  CellStyle="{StaticResource DashboardMovementCellStyle}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DashboardColumnHeaderStyle}"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Data/Ora" Width="120" HeaderStyle="{StaticResource DashboardHeaderLeftStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DateTime, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}" Style="{StaticResource DashboardCellLeftStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tipo" Width="135" HeaderStyle="{StaticResource DashboardHeaderLeftStyle}">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding MovementType, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Carico" Width="90" HeaderStyle="{StaticResource DashboardHeaderCenterStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LoadNumber, Mode=OneWay}" Style="{StaticResource DashboardCellCenterStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Fornitore" Width="1.2*" MinWidth="140" HeaderStyle="{StaticResource DashboardHeaderLeftStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SupplierName, Mode=OneWay}" Style="{StaticResource DashboardCellLeftStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SupplierName, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Materiale" Width="1.05*" MinWidth="135" HeaderStyle="{StaticResource DashboardHeaderLeftStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Material, Mode=OneWay}" Style="{StaticResource DashboardCellLeftStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Material, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Qualità" Width="75" HeaderStyle="{StaticResource DashboardHeaderCenterStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Quality, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource DashboardCellCenterStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="MC" Width="140" HeaderStyle="{StaticResource DashboardHeaderCenterStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CubicMetersDisplay, Mode=OneWay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DashboardCellCenterStyle}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CubicMeters, Converter={StaticResource MovementSignConverter}}" Value="Positive"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding CubicMeters, Converter={StaticResource MovementSignConverter}}" Value="Negative"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Operatore" Width="1*" MinWidth="160" HeaderStyle="{StaticResource DashboardHeaderLeftStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Operator, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource DashboardCellLeftStyle}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Operator, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Click="OpenHistory_Click" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}"
                                Padding="12,5" Cursor="Hand" FontSize="12" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Vedi storico completo" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  &#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Stretch" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource DashboardSectionHeaderStyle}"><TextBlock Text="CARICHI PREVISTI QUESTA SETTIMANA" Style="{StaticResource DashboardSectionTitleStyle}"/></Border>
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="16,10,16,8">
                            <StackPanel>
                                <TextBlock Text="{Binding WeeklyPlannedLoadCountDisplay}" FontSize="15" FontWeight="ExtraBold"/>
                                <TextBlock Text="{Binding WeeklyPlannedCubicMetersDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="2">
                            <ItemsControl ItemsSource="{Binding WeeklyPlannedArrivals}" Margin="12,0,12,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DateDisplay}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SupplierName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MaterialDisplay}" FontWeight="ExtraBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Command="{Binding ConfirmArrivalCommand}" Content="✓  Arrivato" ToolTip="Conferma arrivo" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="6,0,0,0" FontSize="11"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nessun carico previsto questa settimana" Visibility="{Binding IsWeeklyPlanningEmpty, Converter={StaticResource BoolToVisibility}}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="18,10" TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
