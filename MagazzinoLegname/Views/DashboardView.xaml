<UserControl x:Class="MagazzinoLegname.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="DashboardSectionHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHeaderBrush}"/>
            <Setter Property="CornerRadius" Value="14,14,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="DashboardSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <Style x:Key="DashboardMovementCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <Style x:Key="DashboardHeaderLeftStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DashboardHeaderCenterStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DashboardHeaderRightStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DashboardCellLeftStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
        <Style x:Key="DashboardCellCenterStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCellLeftStyle}">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DashboardCellRightStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCellLeftStyle}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <UniformGrid Rows="1" Margin="-7,0,-7,12">
            <Border Style="{StaticResource CardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="PACCHI PRESENTI" FontWeight="Bold"/><TextBlock Text="{Binding PresentPackagesDisplay}" FontSize="42" FontWeight="ExtraBold" Margin="0,14,0,0"/><TextBlock Text="pacchi fisicamente presenti" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#3B2830" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{StaticResource CardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="MC GIACENZA" FontWeight="Bold"/><TextBlock Text="{Binding InventoryCubicMetersDisplay}" FontSize="42" FontWeight="ExtraBold" Margin="0,14,0,0"/><TextBlock Text="MC attualmente presenti" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#3D3A21" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{StaticResource CardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="MC DA CONSOLIDARE" FontWeight="Bold"/><TextBlock Text="{Binding CubicMetersToConsolidateDisplay}" FontSize="42" FontWeight="ExtraBold" Margin="0,14,0,0"/><TextBlock Text="MC con rettifica scarti da completare" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#413224" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{StaticResource CardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="MC REALI" FontWeight="Bold"/><TextBlock Text="{Binding RealCubicMetersDisplay}" FontSize="42" FontWeight="ExtraBold" Margin="0,14,0,0"/><TextBlock Text="MC con rettifica scarti completata" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#253B2B" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Style="{StaticResource CardStyle}" Margin="7,0"><Grid><StackPanel><TextBlock Text="VALORE MAGAZZINO" FontWeight="Bold"/><TextBlock Text="{Binding InventoryValueDisplay}" FontSize="42" FontWeight="ExtraBold" Margin="0,14,0,0"/><TextBlock Text="valore complessivo dei pacchi presenti" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/></StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#253B2B" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="&#xEAF3;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
        </UniformGrid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- RIGA 2: Giacenza per spessore | Attenzioni operative -->
            <Grid Grid.Row="0" Margin="0,10,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65*"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0" ClipToBounds="True">
                    <StackPanel>
                        <Border Style="{StaticResource DashboardSectionHeaderStyle}"><TextBlock Text="GIACENZA PER SPESSORE" Style="{StaticResource DashboardSectionTitleStyle}"/></Border>
                        <StackPanel Margin="12,14,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Spessore" FontWeight="Bold" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Qualità C" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Classificati" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Da classificare" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Grid.Column="1" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Qualità VISTA" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Classificati" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Da classificare" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Grid.Column="1" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                            <TextBlock Text="Totale" FontWeight="Bold" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ThicknessRows}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="1.4*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
                                        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                                        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="{Binding ThicknessDisplay}" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                        <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ClassifiedCDisplay}" FontWeight="Bold" FontSize="14" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ToClassifyCDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Column="2" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ClassifiedVistaDisplay}" FontWeight="Bold" FontSize="14" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ToClassifyVistaDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding TotalAllDisplay}" Grid.Column="3" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <StackPanel>
                        <Border Style="{StaticResource DashboardSectionHeaderStyle}"><TextBlock Text="ATTENZIONI OPERATIVE" Style="{StaticResource DashboardSectionTitleStyle}"/></Border>
                        <StackPanel Margin="12,10,12,12">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="225"/><ColumnDefinition Width="26"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Gruppi da classificare" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="su "/><Run Text="{Binding LoadsToClassify, Mode=OneWay}" FontWeight="Bold"/><Run Text=" carichi"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GroupsToClassify}" Grid.Column="3" FontSize="25" FontWeight="ExtraBold" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="225"/><ColumnDefinition Width="26"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Rettifiche da completare" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="gruppi con scarti da consolidare" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GroupsToConsolidate}" Grid.Column="3" FontSize="25" FontWeight="ExtraBold" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGA 3: Ultimi movimenti -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65*"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0" VerticalAlignment="Stretch" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource DashboardSectionHeaderStyle}"><TextBlock Text="ULTIME MOVIMENTAZIONI" Style="{StaticResource DashboardSectionTitleStyle}"/></Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding RecentMovements}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  MaxHeight="246" HorizontalScrollBarVisibility="Auto" RowHeight="34"
                                  ColumnHeaderHeight="42" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  CellStyle="{StaticResource DashboardMovementCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Data/Ora" Width="120" HeaderStyle="{StaticResource DashboardHeaderLeftStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DateTime, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}" Style="{StaticResource DashboardCellLeftStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tipo" Width="135" HeaderStyle="{StaticResource DashboardHeaderLeftStyle}">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding MovementType, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Carico" Width="65" HeaderStyle="{StaticResource DashboardHeaderCenterStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LoadNumber, Mode=OneWay}" Style="{StaticResource DashboardCellCenterStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Fornitore" Width="135" HeaderStyle="{StaticResource DashboardHeaderLeftStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SupplierName, Mode=OneWay}" Style="{StaticResource DashboardCellLeftStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SupplierName, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Materiale" Width="130" HeaderStyle="{StaticResource DashboardHeaderLeftStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Material, Mode=OneWay}" Style="{StaticResource DashboardCellLeftStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Material, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Qualità" Width="65" HeaderStyle="{StaticResource DashboardHeaderCenterStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Quality, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource DashboardCellCenterStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="MC" Width="100" HeaderStyle="{StaticResource DashboardHeaderRightStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CubicMetersDisplay, Mode=OneWay}" Style="{StaticResource DashboardCellRightStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Operatore" Width="150" HeaderStyle="{StaticResource DashboardHeaderLeftStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Operator, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource DashboardCellLeftStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Operator, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Stretch" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource DashboardSectionHeaderStyle}"><TextBlock Text="CARICHI PREVISTI QUESTA SETTIMANA" Style="{StaticResource DashboardSectionTitleStyle}"/></Border>
                        <Grid Grid.Row="1" Margin="16,10,16,8">
                            <StackPanel>
                                <TextBlock Text="{Binding WeeklyPlannedLoadCountDisplay}" FontSize="15" FontWeight="ExtraBold"/>
                                <TextBlock Text="{Binding WeeklyPlannedCubicMetersDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <ItemsControl ItemsSource="{Binding WeeklyPlannedArrivals}" Margin="12,0,12,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DateDisplay}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SupplierName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MaterialDisplay}" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nessun carico previsto questa settimana" Visibility="{Binding IsWeeklyPlanningEmpty, Converter={StaticResource BoolToVisibility}}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="18,12,18,20" TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
