<UserControl x:Class="MagazzinoLegname.Views.Shared.PageScaffold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="2,0,2,16">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{Binding PageSubtitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <Button Content="Nuova operazione" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="Cerca per codice o descrizione" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" SelectedIndex="0" Margin="0,0,10,0">
                    <ComboBoxItem Content="Tutti gli stati"/>
                    <ComboBoxItem Content="Aperto"/>
                    <ComboBoxItem Content="Completato"/>
                </ComboBox>
                <Button Grid.Column="2" Content="Filtra" Style="{StaticResource SecondaryButtonStyle}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Background="{DynamicResource SurfaceHeaderBrush}" Height="48">
                    <TextBlock Text="ATTIVITÀ RECENTI" Margin="18,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="29" Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,0,14">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nessuna attività disponibile" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="I dati della sezione compariranno qui." Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center"/>
                </StackPanel>
                <ContentPresenter Grid.Row="1" Content="{Binding PageContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
