<UserControl x:Class="MagazzinoLegname.Views.Shared.PageScaffold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,30,36,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding PageTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource PrimaryTextBrush}" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding PageSubtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" Margin="0,7,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,26,0,0" Padding="32" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <ContentPresenter Content="{Binding PageContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Border>
    </Grid>
</UserControl>
