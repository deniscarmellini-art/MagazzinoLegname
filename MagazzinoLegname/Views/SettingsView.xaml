<UserControl x:Class="MagazzinoLegname.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>
  <Style x:Key="SettingsTableTitleStyle" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource SurfaceHeaderBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="CornerRadius" Value="13,13,0,0"/>
   <Setter Property="Padding" Value="16,11"/>
  </Style>
  <Style x:Key="SettingsTableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SettingsLeftHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource SettingsTableHeaderStyle}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style x:Key="SettingsCenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource SettingsTableHeaderStyle}">
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SettingsLeftCellStyle" TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="TextAlignment" Value="Left"/>
   <Setter Property="Margin" Value="12,0"/>
  </Style>
  <Style x:Key="SettingsCenteredCellStyle" TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="TextAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SettingsLeftEditingCellStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="TextAlignment" Value="Left"/>
   <Setter Property="Padding" Value="12,0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SettingsMaterialCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
   <Setter Property="Margin" Value="5,0"/>
   <Setter Property="Padding" Value="16"/>
   <Setter Property="MinHeight" Value="330"/>
   <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,0,0,4"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,14,0"><StackPanel><TextBlock Text="CONFIGURAZIONI" Style="{StaticResource FieldLabelStyle}" Margin="10,7,0,12"/><RadioButton IsChecked="True" Content="Fornitori" Tag="&#xE716;" Style="{StaticResource NavigationButtonStyle}" GroupName="SettingsNav" Click="SuppliersSection_Click"/><RadioButton Content="Parametri materiale" Tag="&#xE9D9;" Style="{StaticResource NavigationButtonStyle}" GroupName="SettingsNav" Click="MaterialParametersSection_Click"/><RadioButton Content="Parametri pianificazione" Tag="&#xE787;" Style="{StaticResource NavigationButtonStyle}" GroupName="SettingsNav" Click="PlanningParametersSection_Click"/><RadioButton Content="Operatori" Tag="&#xE77B;" Style="{StaticResource NavigationButtonStyle}" GroupName="SettingsNav" Click="OperatorsSection_Click"/><RadioButton Content="Materiali di consumo" Tag="&#xE719;" Style="{StaticResource NavigationButtonStyle}" GroupName="SettingsNav" Click="ConsumablesSection_Click" FontSize="11"/><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,10"/><TextBlock Text="AMMINISTRAZIONE" Style="{StaticResource FieldLabelStyle}" Margin="10,4,0,8"/><RadioButton Content="Importazione storico" Tag="&#xE8B5;" Style="{StaticResource NavigationButtonStyle}" GroupName="SettingsNav" Click="LegacyImportSection_Click"/></StackPanel></Border>
   <Grid Grid.Column="1" Visibility="{Binding IsSuppliersSection, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="17,16,17,12"><TextBlock Text="FORNITORI" FontWeight="Bold"/><TextBlock Text="Seleziona un'anagrafica" Style="{StaticResource PageSubtitleStyle}"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" Background="Transparent" BorderThickness="0" Margin="8,0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="7,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Ellipse Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="8,0,0,0"><Ellipse.Style><Style TargetType="Ellipse"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="＋  Nuovo fornitore" Click="AddSupplier_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="15"/></Grid></Border>
    <StackPanel Grid.Column="1">
     <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="12,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CODICE FORNITORE" Style="{StaticResource FieldLabelStyle}"/><TextBox MaxLength="8" Text="{Binding SelectedSupplier.Code, UpdateSourceTrigger=LostFocus}"/></StackPanel><TextBlock Grid.Column="1" Text="Codice breve, obbligatorio e univoco. Evitarne la modifica dopo il primo utilizzo." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><Grid Margin="0,0,0,14"><TextBlock Text="DATI ANAGRAFICI" Style="{StaticResource SettingsSectionTitleStyle}" VerticalAlignment="Center"/><Button Content="Salva anagrafica" Click="SaveSupplier_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid><UniformGrid Columns="4" Rows="1"><StackPanel Margin="0,0,10,10"><TextBlock Text="RAGIONE SOCIALE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.Name}"/></StackPanel><StackPanel Margin="0,0,10,10"><TextBlock Text="PARTITA IVA" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.VatNumber}"/></StackPanel><StackPanel Margin="0,0,10,10"><TextBlock Text="CODICE FISCALE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.TaxCode}"/></StackPanel><StackPanel Margin="0,0,0,10"><TextBlock Text="STATO" Style="{StaticResource FieldLabelStyle}"/><CheckBox Content="Fornitore attivo" IsChecked="{Binding SelectedSupplier.IsActive}" Margin="0,7,0,0" VerticalAlignment="Center"/></StackPanel></UniformGrid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,10"><TextBlock Text="INDIRIZZO" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.Address}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,10"><TextBlock Text="CAP" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.PostalCode}"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,8,10"><TextBlock Text="CITTÀ" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.City}"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,8,10"><TextBlock Text="PROVINCIA" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.Province}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="NAZIONE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.Country}"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="E-MAIL" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.Email}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="PEC (FACOLTATIVA)" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.CertifiedEmail}"/></StackPanel></Grid></StackPanel></Border>
     <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,14" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource SettingsTableTitleStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="REFERENTI" Style="{StaticResource SettingsSectionTitleStyle}"/><TextBlock Text="Modifica direttamente le celle" Style="{StaticResource PageSubtitleStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Elimina referente" Click="DeleteContact_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="＋  Aggiungi referente" Click="AddContact_Click" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Grid></Border><DataGrid Grid.Row="1" ItemsSource="{Binding SelectedSupplier.Contacts}" SelectedItem="{Binding SelectedContact}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="170"><DataGrid.Resources><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SettingsTableHeaderStyle}"/></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="Nome" Width="*" Binding="{Binding FirstName}"/><DataGridTextColumn Header="Cognome" Width="*" Binding="{Binding LastName}"/><DataGridTextColumn Header="Ruolo" Width="*" Binding="{Binding Role}"/><DataGridTextColumn Header="Telefono" Width="*" Binding="{Binding Phone}"/><DataGridTextColumn Header="Cellulare" Width="*" Binding="{Binding Mobile}"/><DataGridTextColumn Header="E-mail" Width="1.3*" Binding="{Binding Email}"/></DataGrid.Columns></DataGrid></Grid></Border>
     <Grid Margin="2,0,2,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CONFIGURAZIONI MATERIALE" Style="{StaticResource SettingsSectionTitleStyle}"/><TextBlock Text="Specifiche per fornitore e spessore convenzionale." Style="{StaticResource PageSubtitleStyle}"/></StackPanel><Button Grid.Column="2" Content="Storico prezzi" Click="ToggleHistory_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/></Grid>
     <ItemsControl ItemsSource="{Binding Configurations}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SettingsMaterialCardStyle}"><StackPanel><TextBlock Text="{Binding Configuration.ConventionalThickness, StringFormat=SPESSORE {0:N2}}" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/><CheckBox Content="Prepiallatura attiva" IsChecked="{Binding Configuration.IsPlaningEnabled}" Margin="0,0,0,9"/><TextBlock Text="RIDUZIONE (MM)" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource NumericTextBoxStyle}" IsEnabled="{Binding Configuration.IsPlaningEnabled}" Text="{Binding Configuration.PlaningReductionMillimeters, StringFormat=N2}" Margin="0,0,0,10"/><Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,10"><StackPanel><TextBlock Text="PREZZO CORRENTE" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding Configuration.CurrentPrice, StringFormat={}{0:N2} €/m³}" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border><TextBlock Text="NUOVO PREZZO €/M³" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding NewPrice, StringFormat=N2}" Margin="0,0,0,8"/><TextBlock Text="VALIDO DAL" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding ValidFrom}" Margin="0,0,0,9"/><Button Content="Crea prezzo" Tag="{Binding}" Click="AddPrice_Click" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Column="1" Visibility="{Binding IsMaterialParametersSection, Converter={StaticResource BoolToVisibility}}">
    <Border Style="{StaticResource CardStyle}"><StackPanel><Grid Margin="0,0,0,15"><StackPanel><TextBlock Text="Parametri materiale" FontSize="20" FontWeight="Bold"/><TextBlock Text="Configura le famiglie di spessore utilizzate dal magazzino e la certificazione predefinita." Style="{StaticResource PageSubtitleStyle}"/></StackPanel><Button Content="Applica parametri" Click="SaveMaterialParameters_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid><ItemsControl ItemsSource="{Binding MaterialParameters.ThicknessFamilies}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="11" Padding="14" Margin="6,0"><StackPanel><TextBlock Text="{Binding FamilyLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="ExtraBold" FontSize="17" Margin="0,0,0,12"/><TextBlock Text="SPESSORE CONVENZIONALE" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding ConventionalThickness, UpdateSourceTrigger=LostFocus, StringFormat=N2}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="6,16,6,0" MaxWidth="620" HorizontalAlignment="Left"><StackPanel><TextBlock Text="CERTIFICAZIONE LEGNAME PREDEFINITA" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,0,0,10"/><TextBox Width="280" HorizontalAlignment="Left" Text="{Binding GeneralSettings.DefaultTimberCertification, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Il valore verrà copiato nel singolo carico al momento della registrazione." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></Border>
   </StackPanel>
   <StackPanel Grid.Column="1" Visibility="{Binding IsPlanningParametersSection, Converter={StaticResource BoolToVisibility}}">
    <Border Style="{StaticResource CardStyle}"><StackPanel><Grid Margin="0,0,0,16"><StackPanel><TextBlock Text="Parametri pianificazione" FontSize="20" FontWeight="Bold"/><TextBlock Text="MC standard di un arrivo previsto, distinto per spessore convenzionale." Style="{StaticResource PageSubtitleStyle}"/></StackPanel><Button Content="Salva parametri" Click="SavePlanningSettings_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid><UniformGrid Rows="1" Columns="3" MaxWidth="900" HorizontalAlignment="Left"><Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="11" Padding="16" Margin="0,0,10,0"><StackPanel Width="220"><TextBlock Text="SPESSORE 23" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/><TextBlock Text="MC STANDARD PER CARICO PREVISTO" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding PlanningSettings.StandardCubicMetersPerExpectedLoad23, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/><TextBlock Text="Quantità attribuita a un arrivo 23." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border><Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="11" Padding="16" Margin="0,0,10,0"><StackPanel Width="220"><TextBlock Text="SPESSORE 34" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/><TextBlock Text="MC STANDARD PER CARICO PREVISTO" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding PlanningSettings.StandardCubicMetersPerExpectedLoad34, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/><TextBlock Text="Quantità attribuita a un arrivo 34." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border><Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="11" Padding="16"><StackPanel Width="220"><TextBlock Text="SPESSORE 44" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/><TextBlock Text="MC STANDARD PER CARICO PREVISTO" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding PlanningSettings.StandardCubicMetersPerExpectedLoad44, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/><TextBlock Text="Quantità attribuita a un arrivo 44." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid></StackPanel></Border>
   </StackPanel>
   <StackPanel Grid.Column="1" Visibility="{Binding IsOperatorsSection, Converter={StaticResource BoolToVisibility}}">
    <Border Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource SettingsTableTitleStyle}">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="OPERATORI" Style="{StaticResource SettingsSectionTitleStyle}"/><TextBlock Text="Gestisci gli operatori disponibili per le nuove operazioni. Le celle Nome e Cognome sono modificabili direttamente." Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
        <Button Grid.Column="1" Content="＋  Aggiungi operatore" Click="AddOperator_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <DataGrid x:Name="OperatorsGrid" Grid.Row="1" ItemsSource="{Binding Operators}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="42">
       <DataGrid.Resources><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SettingsTableHeaderStyle}"/></DataGrid.Resources>
       <DataGrid.Columns>
        <DataGridTextColumn Header="Nome" Width="1.2*" Binding="{Binding FirstName, UpdateSourceTrigger=LostFocus}" HeaderStyle="{StaticResource SettingsLeftHeaderStyle}" ElementStyle="{StaticResource SettingsLeftCellStyle}" EditingElementStyle="{StaticResource SettingsLeftEditingCellStyle}"/>
        <DataGridTextColumn Header="Cognome" Width="1.2*" Binding="{Binding LastName, UpdateSourceTrigger=LostFocus}" HeaderStyle="{StaticResource SettingsLeftHeaderStyle}" ElementStyle="{StaticResource SettingsLeftCellStyle}" EditingElementStyle="{StaticResource SettingsLeftEditingCellStyle}"/>
        <DataGridTextColumn Header="Stato" Width="140" Binding="{Binding Status}" IsReadOnly="True" HeaderStyle="{StaticResource SettingsCenteredHeaderStyle}" ElementStyle="{StaticResource SettingsCenteredCellStyle}"/>
        <DataGridTemplateColumn Header="Azioni" Width="250" HeaderStyle="{StaticResource SettingsCenteredHeaderStyle}">
         <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Modifica" Tag="{Binding}" Click="EditOperator_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0"/><Button Content="{Binding ToggleActionLabel}" Tag="{Binding}" Click="ToggleOperator_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
   </StackPanel>
   <ScrollViewer Grid.Column="1" Visibility="{Binding IsConsumablesSection, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/></Grid.RowDefinitions>
     <Border Style="{StaticResource SettingsTableTitleStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MATERIALI DI CONSUMO" Style="{StaticResource SettingsSectionTitleStyle}"/><TextBlock Text="Anagrafica indipendente dalle configurazioni del legname" Style="{StaticResource PageSubtitleStyle}"/></StackPanel><Button Grid.Column="1" Content="＋ Nuovo articolo" Click="AddConsumable_Click" Style="{StaticResource PrimaryButtonStyle}"/></Grid></Border>
     <DataGrid Grid.Row="1" ItemsSource="{Binding ConsumableItems}" SelectedItem="{Binding SelectedConsumable}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns>
      <DataGridTextColumn Header="Codice" Binding="{Binding InternalCode}" Width="82"/><DataGridTextColumn Header="Prodotto" Binding="{Binding ProductName}" Width="1.5*"/><DataGridTextColumn Header="Reparto / Utilizzo" Binding="{Binding Department}" Width="1.15*"/><DataGridTextColumn Header="Fornitore" Binding="{Binding SupplierName}" Width="1.1*"/><DataGridTextColumn Header="UDM" Binding="{Binding UnitOfMeasure}" Width="58"/><DataGridTextColumn Header="Qtà/UDM" Binding="{Binding QuantityPerUnit, StringFormat=N2}" Width="78"/><DataGridTextColumn Header="Scorta min." Binding="{Binding MinimumStock, StringFormat=N2}" Width="82"/><DataGridTextColumn Header="Consumo medio" Binding="{Binding ConsumptionAverageText}" Width="1.1*"/><DataGridTextColumn Header="Lead time" Binding="{Binding LeadTimeText}" Width="90"/><DataGridTextColumn Header="Stato" Binding="{Binding StatusDisplay}" Width="88"/>
      <DataGridTemplateColumn Header="Azioni" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Modifica" Tag="{Binding}" Click="EditConsumable_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,5,0"/><Button Content="{Binding ToggleActionLabel}" Tag="{Binding}" Click="ToggleConsumableRow_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns></DataGrid></Grid></Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><StackPanel><Grid Margin="0,0,0,12"><TextBlock Text="ANAGRAFICA ARTICOLO" FontWeight="Bold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Attiva / Disattiva" Click="ToggleConsumable_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Salva" Click="SaveConsumable_Click" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Grid>
      <UniformGrid Columns="4"><StackPanel Margin="0,0,8,9"><TextBlock Text="CODICE INTERNO" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedConsumable.InternalCode}" IsReadOnly="True"/></StackPanel><StackPanel Margin="0,0,8,9"><TextBlock Text="PRODOTTO" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedConsumable.ProductName}"/></StackPanel><StackPanel Margin="0,0,8,9"><TextBlock Text="FORNITORE" Style="{StaticResource FieldLabelStyle}"/><ComboBox IsEditable="True" ItemsSource="{Binding ConsumableSuppliers}" Text="{Binding SelectedConsumable.SupplierName}"/></StackPanel><StackPanel Margin="0,0,0,9"><TextBlock Text="REPARTO / UTILIZZO" Style="{StaticResource FieldLabelStyle}"/><ComboBox IsEditable="True" ItemsSource="{Binding ConsumableDepartments}" Text="{Binding SelectedConsumable.Department}"/></StackPanel>
       <StackPanel Margin="0,0,8,9"><TextBlock Text="UDM" Style="{StaticResource FieldLabelStyle}"/><ComboBox IsEditable="True" ItemsSource="{Binding ConsumableUnits}" Text="{Binding SelectedConsumable.UnitOfMeasure}"/></StackPanel><StackPanel Margin="0,0,8,9"><TextBlock Text="QTÀ PER UDM" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedConsumable.QuantityPerUnit}"/></StackPanel><StackPanel Margin="0,0,8,9"><TextBlock Text="SCORTA MINIMA" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedConsumable.MinimumStock}"/></StackPanel><StackPanel Margin="0,0,0,9"><TextBlock Text="LEAD TIME (TESTO)" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedConsumable.LeadTimeText}"/></StackPanel><StackPanel Margin="0,0,8,9"><TextBlock Text="STATO" Style="{StaticResource FieldLabelStyle}"/><CheckBox Content="Articolo attivo" IsChecked="{Binding SelectedConsumable.IsActive}"/></StackPanel>
       <StackPanel Margin="0,0,8,9"><TextBlock Text="CONSUMO MEDIO ORIGINALE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedConsumable.ConsumptionAverageText}"/></StackPanel><StackPanel Margin="0,0,8,9"><TextBlock Text="QUANTITÀ MEDIA (OPZ.)" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedConsumable.ConsumptionAverageQuantity}"/></StackPanel><StackPanel Margin="0,0,8,9"><TextBlock Text="PERIODICITÀ" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding ConsumptionPeriods}" SelectedItem="{Binding SelectedConsumable.ConsumptionPeriod}"/></StackPanel><StackPanel Margin="0,0,0,9"><TextBlock Text="FOTO" Style="{StaticResource FieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedConsumable.PhotoPath}" IsReadOnly="True"/><Button Grid.Column="1" Content="Seleziona" Click="SelectConsumablePhoto_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" Margin="5,0"/><Button Grid.Column="2" Content="Rimuovi" Click="RemoveConsumablePhoto_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="8,5"/></Grid></StackPanel>
      </UniformGrid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="PACKAGING" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedConsumable.Packaging}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="NOTE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedConsumable.Notes}"/></StackPanel></Grid>
     </StackPanel></Border>
     <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="IMPORTAZIONE LEGACY CONSUMABILI" FontWeight="Bold"/><TextBlock Text="Seleziona → Analizza → verifica l'anteprima → Conferma importazione" Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ConsumablesLegacyFilePath}" IsReadOnly="True"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"><Button Content="Importa da Excel storico" Click="SelectConsumablesLegacy_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Analizza" Click="AnalyzeConsumablesLegacy_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Conferma importazione" Click="ImportConsumablesLegacy_Click" IsEnabled="{Binding ConsumablesImportPlan.CanImport}" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Grid><TextBlock Text="{Binding ConsumablesImportPlan.Summary}" Margin="0,10,0,0" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding ConsumablesImportPlan.Warnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding ConsumablesImportPlan.Photos}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Description}"/><TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource SecondaryTextBrush}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></Border>
