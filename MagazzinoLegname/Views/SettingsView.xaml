<UserControl x:Class="MagazzinoLegname.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,0,0,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="2,0,0,16"><TextBlock Text="Impostazioni" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Gestisci anagrafiche e configurazioni operative dell'applicazione." Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,14,0"><StackPanel><TextBlock Text="CONFIGURAZIONI" Style="{StaticResource FieldLabelStyle}" Margin="10,7,0,12"/><RadioButton Content="Generali" Tag="&#xE713;" Style="{StaticResource NavigationButtonStyle}" GroupName="SettingsNav" Click="GeneralSection_Click"/><RadioButton IsChecked="True" Content="Fornitori" Tag="&#xE716;" Style="{StaticResource NavigationButtonStyle}" GroupName="SettingsNav" Click="SuppliersSection_Click"/><RadioButton Content="Parametri materiale" Tag="&#xE9D9;" Style="{StaticResource NavigationButtonStyle}" GroupName="SettingsNav" Click="MaterialParametersSection_Click"/><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,10"/><TextBlock Text="SEZIONI FUTURE" Style="{StaticResource FieldLabelStyle}" Margin="10,4,0,8"/><Button Content="Operatori" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Margin="0,0,0,6"/><Button Content="Altre configurazioni" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"/></StackPanel></Border>
   <StackPanel Grid.Column="1" Visibility="{Binding IsGeneralSection, Converter={StaticResource BoolToVisibility}}">
    <Border Style="{StaticResource CardStyle}"><StackPanel><Grid Margin="0,0,0,16"><StackPanel><TextBlock Text="Impostazioni generali" FontSize="20" FontWeight="Bold"/><TextBlock Text="Valori predefiniti applicati alle nuove operazioni." Style="{StaticResource PageSubtitleStyle}"/></StackPanel><Button Content="Salva impostazioni" Click="SaveGeneralSettings_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid><Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="11" Padding="16" MaxWidth="520" HorizontalAlignment="Left"><StackPanel><TextBlock Text="CERTIFICAZIONE LEGNAME PREDEFINITA" Style="{StaticResource FieldLabelStyle}"/><TextBox Width="280" HorizontalAlignment="Left" Text="{Binding GeneralSettings.DefaultTimberCertification, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Il valore verrà copiato nel singolo carico al momento della registrazione." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></Border>
   </StackPanel>
   <Grid Grid.Column="1" Visibility="{Binding IsSuppliersSection, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="17,16,17,12"><TextBlock Text="FORNITORI" FontWeight="Bold"/><TextBlock Text="Seleziona un'anagrafica" Style="{StaticResource PageSubtitleStyle}"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" Background="Transparent" BorderThickness="0" Margin="8,0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="7,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Ellipse Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="8,0,0,0"><Ellipse.Style><Style TargetType="Ellipse"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="＋  Nuovo fornitore" Click="AddSupplier_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="15"/></Grid></Border>
    <StackPanel Grid.Column="1">
     <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CODICE FORNITORE" Style="{StaticResource FieldLabelStyle}"/><TextBox MaxLength="8" Text="{Binding SelectedSupplier.Code, UpdateSourceTrigger=LostFocus}"/></StackPanel><TextBlock Grid.Column="1" Text="Codice breve, obbligatorio e univoco. Evitarne la modifica dopo il primo utilizzo." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><Grid Margin="0,0,0,14"><TextBlock Text="Dati anagrafici" FontSize="18" FontWeight="Bold"/><Button Content="Salva anagrafica" Click="SaveSupplier_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid><UniformGrid Columns="4" Rows="1"><StackPanel Margin="0,0,10,10"><TextBlock Text="RAGIONE SOCIALE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.Name}"/></StackPanel><StackPanel Margin="0,0,10,10"><TextBlock Text="PARTITA IVA" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.VatNumber}"/></StackPanel><StackPanel Margin="0,0,10,10"><TextBlock Text="CODICE FISCALE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.TaxCode}"/></StackPanel><StackPanel><TextBlock Text="STATO" Style="{StaticResource FieldLabelStyle}"/><CheckBox Content="Fornitore attivo" IsChecked="{Binding SelectedSupplier.IsActive}" Margin="2,9,0,0"/></StackPanel></UniformGrid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,10"><TextBlock Text="INDIRIZZO" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.Address}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,10"><TextBlock Text="CAP" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.PostalCode}"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,8,10"><TextBlock Text="CITTÀ" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.City}"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,8,10"><TextBlock Text="PROVINCIA" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.Province}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="NAZIONE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.Country}"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="E-MAIL" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.Email}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="PEC (FACOLTATIVA)" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SelectedSupplier.CertifiedEmail}"/></StackPanel></Grid></StackPanel></Border>
     <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="16,13"><StackPanel><TextBlock Text="Referenti" FontSize="17" FontWeight="Bold"/><TextBlock Text="Modifica direttamente le celle" Style="{StaticResource PageSubtitleStyle}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Elimina referente" Click="DeleteContact_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="＋  Aggiungi referente" Click="AddContact_Click" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding SelectedSupplier.Contacts}" SelectedItem="{Binding SelectedContact}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="170"><DataGrid.Columns><DataGridTextColumn Header="Nome" Width="*" Binding="{Binding FirstName}"/><DataGridTextColumn Header="Cognome" Width="*" Binding="{Binding LastName}"/><DataGridTextColumn Header="Ruolo" Width="*" Binding="{Binding Role}"/><DataGridTextColumn Header="Telefono" Width="*" Binding="{Binding Phone}"/><DataGridTextColumn Header="Cellulare" Width="*" Binding="{Binding Mobile}"/><DataGridTextColumn Header="E-mail" Width="1.3*" Binding="{Binding Email}"/></DataGrid.Columns></DataGrid></Grid></Border>
     <Grid Margin="2,0,2,12"><StackPanel><TextBlock Text="Configurazioni materiale" FontSize="19" FontWeight="Bold"/><TextBlock Text="Specifiche per fornitore e spessore convenzionale." Style="{StaticResource PageSubtitleStyle}"/></StackPanel><Button Content="Storico prezzi" Click="ToggleHistory_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"/></Grid>
     <ItemsControl ItemsSource="{Binding Configurations}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="5,0" Padding="14"><StackPanel><TextBlock Text="{Binding Configuration.ConventionalThickness, StringFormat=SPESSORE {0:N0}}" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/><CheckBox Content="Prepiallatura attiva" IsChecked="{Binding Configuration.IsPlaningEnabled}" Margin="0,0,0,9"/><TextBlock Text="RIDUZIONE (MM)" Style="{StaticResource FieldLabelStyle}"/><TextBox IsEnabled="{Binding Configuration.IsPlaningEnabled}" Text="{Binding Configuration.PlaningReductionMillimeters}" Margin="0,0,0,10"/><Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="9" Padding="10" Margin="0,0,0,10"><StackPanel><TextBlock Text="PREZZO CORRENTE" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding Configuration.CurrentPrice, StringFormat={}{0:N2} €/m³}" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border><TextBlock Text="NUOVO PREZZO €/M³" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding NewPrice}" Margin="0,0,0,8"/><TextBlock Text="VALIDO DAL" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding ValidFrom}" Margin="0,0,0,9"/><Button Content="Crea prezzo" Tag="{Binding}" Click="AddPrice_Click" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Column="1" Visibility="{Binding IsMaterialParametersSection, Converter={StaticResource BoolToVisibility}}">
    <Border Style="{StaticResource CardStyle}"><StackPanel><Grid Margin="0,0,0,15"><StackPanel><TextBlock Text="Configurazione spessori e lavorazioni" FontSize="20" FontWeight="Bold"/><TextBlock Text="Le riduzioni dimensionali determinano la perdita teorica di lavorazione; non vengono applicate percentuali fisse." Style="{StaticResource PageSubtitleStyle}"/></StackPanel><Button Content="Applica parametri" Click="SaveMaterialParameters_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid><ItemsControl ItemsSource="{Binding MaterialParameters.ThicknessFamilies}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="11" Padding="16" Margin="6,0"><StackPanel><TextBlock Text="{Binding FamilyLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="ExtraBold" FontSize="17" Margin="0,0,0,13"/><TextBlock Text="SPESSORE CONVENZIONALE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding ConventionalThickness, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/><TextBlock Text="SPESSORE UTILE FINALE" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding UsefulProductionThickness, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/><TextBlock Text="RIDUZIONE STANDARD LARGHEZZA (MM)" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding StandardWidthReductionMillimeters, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/><TextBlock Text="RIDUZIONE LUNGHEZZA FINGER JOINT (MM)" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding FingerJointLengthReductionMillimeters, UpdateSourceTrigger=LostFocus}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="239,14,0,0" Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVisibility}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="STORICO PREZZI — VALIDITÀ PER SPESSORE" Margin="18,14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/><DataGrid Grid.Row="1" ItemsSource="{Binding PriceHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="250"><DataGrid.Columns><DataGridTextColumn Header="Spessore" Width="*" Binding="{Binding ConventionalThickness}"/><DataGridTextColumn Header="Prezzo €/m³" Width="*" Binding="{Binding PricePerCubicMeter, StringFormat=N2}"/><DataGridTextColumn Header="Valido dal" Width="*" Binding="{Binding ValidFrom, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Valido al" Width="*" Binding="{Binding ValidTo, StringFormat=dd/MM/yyyy, TargetNullValue=In corso}"/></DataGrid.Columns></DataGrid></Grid></Border>
 </Grid></ScrollViewer>
</UserControl>
