<Window x:Class="MagazzinoLegname.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magazzino Legname" Height="860" Width="1440"
        MinHeight="700" MinWidth="1120" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Inter, Segoe UI" TextOptions.TextFormattingMode="Display">
    <Grid Margin="20,12,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="84" Height="84" CornerRadius="0"
                            Background="#000000"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Image Source="Assets/logo-essepi-finestre-xlam.jpg"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"/>
                    </Border>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="Magazzino Legname" FontSize="30" FontWeight="ExtraBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="HeaderDescription" Text="Gestione materiali, giacenze e movimentazioni" Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="720"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="Utente" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="Operatore" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="U" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,10,0,0" Padding="4" Background="#0F151C"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.12*"/>
                            <ColumnDefinition Width="0.88*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="Dashboard" Tag="&#xE80F;" IsChecked="True" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Grid.Column="1" Content="Entrata merce" Tag="&#xE896;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Grid.Column="2" Content="Classificazione" Tag="&#xE8EC;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Grid.Column="3" Content="Rettifica scarti" Tag="&#xE74D;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Grid.Column="4" Content="Scarico materiale" Tag="&#xE7C1;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Grid.Column="5" Content="Giacenze" Tag="&#xE7B8;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Grid.Column="6" Content="Pianificazione" Tag="&#xE787;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Grid.Column="7" Content="Storico" Tag="&#xE81C;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Grid.Column="8" Content="Impostazioni" Tag="&#xE713;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="PageContent" Grid.Row="1"/>

        <Grid Grid.Row="2" Margin="4,10,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="Magazzino Legname" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Opacity="0.55"/>
            <TextBlock Grid.Column="1" Text="Sistema gestionale" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Opacity="0.55" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="© 2026" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Opacity="0.55" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
