<Window x:Class="MagazzinoLegname.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magazzino Legname" Height="860" Width="1440"
        MinHeight="700" MinWidth="1120" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Inter, Segoe UI" TextOptions.TextFormattingMode="Display">
    <Grid Margin="24,20,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="20,14" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="62" Height="62" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Magazzino Legname" FontSize="34" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Gestione materiali, giacenze e movimentazioni" Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="Utente" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="Operatore" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="U" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,14,0,0" Padding="4" Background="#0F151C"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                    <UniformGrid Rows="1">
                        <RadioButton Content="Dashboard" Tag="&#xE80F;" IsChecked="True" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Entrata merce" Tag="&#xE896;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Classificazione" Tag="&#xE8EC;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Rettifica scarti" Tag="&#xE74D;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Scarico materiale" Tag="&#xE7C1;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Giacenze" Tag="&#xE7B8;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Pianificazione" Tag="&#xE787;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Storico" Tag="&#xE81C;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Impostazioni" Tag="&#xE713;" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="PageContent" Grid.Row="1"/>

        <Grid Grid.Row="2" Margin="4,10,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="Magazzino Legname" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Opacity="0.55"/>
            <TextBlock Grid.Column="1" Text="Sistema gestionale" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Opacity="0.55" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="© 2026" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Opacity="0.55" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
