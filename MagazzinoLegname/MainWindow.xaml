<Window x:Class="MagazzinoLegname.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magazzino Legname" Height="820" Width="1360"
        MinHeight="640" MinWidth="960" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource HeaderBackgroundBrush}">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Magazzino Legname" Foreground="{DynamicResource HeaderForegroundBrush}"
                               FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="Gestione centralizzata del magazzino" Foreground="{DynamicResource HeaderMutedBrush}"
                               FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource HeaderBadgeBrush}" CornerRadius="18"
                        Padding="14,8" VerticalAlignment="Center">
                    <TextBlock Text="GESTIONALE AZIENDALE" Foreground="{DynamicResource HeaderForegroundBrush}"
                               FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,22,14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="MENU PRINCIPALE" Style="{StaticResource SidebarSectionLabelStyle}"/>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <RadioButton Content="Dashboard" Tag="Dashboard" IsChecked="True" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Entrata merce" Tag="GoodsReceipt" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Classificazione" Tag="Classification" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Rettifica scarti" Tag="WasteCorrection" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Scarico materiale" Tag="MaterialDispatch" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Giacenze" Tag="Inventory" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Pianificazione" Tag="Planning" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                        <RadioButton Content="Storico" Tag="History" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0,8,12"/>
                        <RadioButton Content="Impostazioni" Tag="Settings" Style="{StaticResource NavigationButtonStyle}" Click="NavigationButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="PageContent" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
